			return
		end

		local var_20_0 = string.gsub(arg_20_0, "\n", "")

		var_0_0:sender10945(var_20_0)
	end

	local function var_19_1()
		return
	end

	CommonAlert.showInputApply(nil, TI18N("Vui lòng nhập giftcode"), TI18N("Đổi quà"), var_19_0, nil, nil, true, var_19_1, 18, CommonAlert.type.rich, FALSE)
end

