function GuildNewwarAwardWindow:__init()
    self.win_type = WinType.Full
    self.is_full_screen = true
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("guildmarketplacereward", "guildmarketplacereward"), type = ResourcesType.plist},
    }
    self.layout_name = "guildnewwar/guildnewwar_award_list_panel"
end

