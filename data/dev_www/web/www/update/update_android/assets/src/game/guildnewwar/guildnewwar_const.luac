GuildNewwarConst = GuildNewwarConst or {} 

-- 标签页
GuildNewwarConst.index = {
    list = 1,         -- 对阵列表
    positions = 2,    -- 战场阵地
    award = 3,        -- 奖励预览
}

-- 据点状态
GuildNewwarConst.position_status = {
	normal = 0, 	   -- 正常
	attacked = 1,      -- 正在被攻击
	fall = 2, 		   -- 已沦陷
}

-- 阵地类型
GuildNewwarConst.positions = {
	myself = 1, 	  -- 我方阵地
	others = 2, 	  -- 敌方阵地
}

-- 联盟战状态
GuildNewwarConst.status = {
	close = 1, 		-- 未开启
	matching = 2, 	-- 匹配中
	showing = 3,	-- 匹配结果展示中
	processing = 4, -- 开战中
	settlement = 5, -- 结算中
}

-- 据点难度
GuildNewwarConst.difficulty = {
	easy = 1, 		-- 简单
	common = 2, 	-- 普通
	difficult = 3,	-- 困难
}

-- 联盟战战斗结果
GuildNewwarConst.result = {
	fighting = 0,  -- 战斗中
	lose = 1, 	   -- 失败
	win = 2, 	   -- 胜利
	dogfall = 3,   -- 平局
}

-- 对阵列表文字提示颜色
GuildNewwarConst.against_color = {
	[1] = cc.c3b(104,69,42),  -- 已结束
	[2] = cc.c3b(58,120,196), -- 进行中
	[3] = cc.c3b(121,121,121),-- 平局
}

-- 宝箱类型
GuildNewwarConst.box_type = {
	copper = 0, -- 铜宝箱
	gold = 1,   -- 金宝箱
}

GuildNewwarConst.BattleType = {
    nomal        = 1, --常规赛
    elite  = 2, --精英赛
}

-- 段位排行榜
GuildNewwarConst.RankType = {
    division = 1,  --赛区排行
    legend = 2   --传奇排行
}
-----------------------------------传奇赛
GuildNewwarConst.guessing_tab = {
    eGuessing   =  1, --竞猜
    ePromotion  =  2, --64强
    eChampion   =  3, --8强
}

GuildNewwarConst.guessing_bet_type = {
	no_bet = 0, --为下注
	bet_a = 1, --下注a
	bet_b = 2, --下注b
}
--赛程阶段
GuildNewwarConst.guessing_set_type = {
	set_type_0 = 0, --未开始
	set_type_64 = 1, --64强
	set_type_32 = 2, --32强
	set_type_16 = 3, --16强
	set_type_8 = 4, --8强
	set_type_4 = 5, --4强
	set_type_final = 6, --决赛
}
--阶段状态
GuildNewwarConst.guessing_set_status_type = {
	set_status_Idle = 1,    --空闲
	set_status_preparation = 2, -- 准备
	set_status_broadcast = 3, --广播
	set_status_quiz = 4,  --竞猜
	set_status_battle= 5, --对战
	set_status_settle= 6, --结算
}
--是否更新当前UI信息
GuildNewwarConst.guessing_flag_type = {
	no_demand = 0, --不需要
	demand_nomal = 1, --需要
	demand_radio = 2, --更新UI并请求观看录像
}
--是否满足开启条件
GuildNewwarConst.guessing_open_type = {
	meet_conditions = 0, --未达到开始条件
	meet_conditions = 1, --已经达到开启条件
	guild_count_unenough = 2, --公会数量不足
}