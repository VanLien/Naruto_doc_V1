function GuildnewwarEliteTeamListItem:addCallBack(call_back)
    self.call_back = call_back
end

function GuildnewwarEliteTeamListItem:setData(data)
    self.formation_type = data.formation_type
    self.head_name:setString(data.name)
    if data._index > 30 then
        self.team_name:setString(TI18N("语言_c_5394"))
        self.team_name:setTextColor(cc.c3b(255, 237, 214))
        setChildUnEnabled(true, self.num_bg)
    else
        self.team_name:setString(TI18N("语言_c_4827") .. data._index)
        self.team_name:setTextColor(cc.c3b(255, 237, 214))
        setChildUnEnabled(false, self.num_bg)
    end
    self.power_txt:setString(data.power)
    self.role_head:setHeadRes(data.face, false, LOADTEXT_TYPE, data.face_file, data.face_update_time)
    self.role_head:setLev(data.lev)
    local avatar_bid = data.avatar_bid
    local vo = Config.AvatarData.data_avatar[avatar_bid]
    if vo then
        local res_id = vo.res_id or 1
        local res = PathTool.getTargetRes("headcircle", "txt_cn_headcircle_" .. res_id, false, false)
        self.role_head:showBg(res, nil, false, vo.offy)
    end

    local res = PathTool.getResFrame("form", "form_icon_"..self.formation_type)
    loadSpriteTexture(self.form_icon, res, LOADTEXT_TYPE_PLIST)
    self:calculateCampHaloType(data.defense)
    local function getFormPosData(index)
        local config = Config.FormationData.data_form_data[self.formation_type]
        local t_pos = config.pos[index][2]
        for k, v in pairs(data.defense) do
            if v.pos == index then
                return v
            end
        end
        return {}
    end
    for i, v in ipairs(self.hero_item_list) do
        local data = getFormPosData(i)-- data.defense[i] or {}
        v:setData(data)
    end
end

--计算阵型icon
function GuildnewwarEliteTeamListItem:calculateCampHaloType(form_list)
    if not form_list then return end
    local dic_camp = {}
    for i,v in pairs(form_list) do
        local config = Config.PartnerData.data_partner_base[v.bid]
        if config.camp_type ~= nil then
            if dic_camp[config.camp_type] == nil then
                dic_camp[config.camp_type] = 1
            else
                dic_camp[config.camp_type] = dic_camp[config.camp_type] + 1
            end
        end
    end

    self.halo_form_id_list = BattleController:getInstance():getModel():getFormIdListByCamp(dic_camp)
    local halo_icon_config, alien_effect = BattleController:getInstance():getModel():getCampIconConfigByIds(clone(self.halo_form_id_list))
    if halo_icon_config then
        local halo_res = PathTool.getCampGroupIcon(halo_icon_config.icon)
        self.halo_icon_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_icon_load)
        addCountForCampIcon(self.halo_btn, halo_icon_config.nums)
        -- self.halo_label:setString("")
        -- self:updateEffect(true, halo_res, alien_effect)
    else
        local halo_res = PathTool.getCampGroupIcon(1000)
        self.halo_icon_load = loadImageTextureFromCDN(self.halo_btn, halo_res, ResourcesType.single, self.halo_icon_load)
        addCountForCampIcon(self.halo_btn)
        -- self.halo_label:setString(TI18N("语言_c_3170"))
        -- self:updateEffect(false, halo_res)
    end
end

function GuildnewwarEliteTeamListItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end