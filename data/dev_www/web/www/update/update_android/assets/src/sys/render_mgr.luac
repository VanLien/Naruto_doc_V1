RenderMgr = RenderMgr or BaseClass()
RenderMgr.RENDER_MANAGER_TIMER = "RenderMgr.RENDER_MANAGER_TIMER"
RenderMgr.REPORT_SYS_TIME = "RenderMgr.REPORT_SYS_TIME"

function RenderMgr.__init(arg_1_0)
	if RenderMgr.Instance ~= nil then
		error("[RenderMgr] is singleton")

		return
	end

	RenderMgr.Instance = arg_1_0
	arg_1_0.count = 0
	arg_1_0.dic = {}
	arg_1_0.funDic = {}
	arg_1_0.next_do_list = {}
	arg_1_0.isStop = true
	arg_1_0.cd_check = 0
	arg_1_0.game_net = GameNet:getInstance()
	arg_1_0.dispatcher = GlobalEvent:getInstance()
	arg_1_0.sharedScheduler = cc.Director:getInstance():getScheduler()
end

function RenderMgr.getInstance(arg_2_0)
	if RenderMgr.Instance == nil then
		RenderMgr.New()
	end

	return RenderMgr.Instance
end

function RenderMgr.start(arg_3_0)
	if arg_3_0.isStop == false then
		return
	end

	arg_3_0.isStop = false

	if arg_3_0.schedule_ == nil then
		arg_3_0.schedule_ = arg_3_0.sharedScheduler:scheduleScriptFunc(function(arg_4_0)
			arg_3_0:update(arg_4_0)
		end, 0, false)
	end
end

function RenderMgr.stop(arg_5_0)
	if arg_5_0.isStop == true then
		return
	end

	arg_5_0.isStop = true

	if arg_5_0.schedule_ then
		arg_5_0.sharedScheduler:unscheduleScriptEntry(arg_5_0.schedule_)
	end

	arg_5_0.schedule_ = nil
end

function RenderMgr.frameAddCall(arg_6_0, arg_6_1, arg_6_2)
	if arg_6_1 and arg_6_2 and arg_6_0.funDic[arg_6_2] == nil then
		arg_6_0.funDic[arg_6_2] = arg_6_1
	end
end

function RenderMgr.frameRemoveCall(arg_7_0, arg_7_1)
	if arg_7_1 and arg_7_0.funDic[arg_7_1] then
		arg_7_0.funDic[arg_7_1] = nil
	end
end

function RenderMgr.getRenderCallById(arg_8_0, arg_8_1)
	return arg_8_0.funDic[arg_8_1]
end

function RenderMgr.add(arg_9_0, arg_9_1)
	if arg_9_1.update == nil then
		print("[RenderMgr]>>worning: " .. tostring(arg_9_1) .. "not update function, I can't render it!!!!!")

		return
	end

	arg_9_0.count = arg_9_0.count + 1
	arg_9_0.dic[arg_9_1] = arg_9_1
end

function RenderMgr.remove(arg_10_0, arg_10_1)
	if arg_10_0.dic[arg_10_1] ~= nil then
		arg_10_0.count = arg_10_0.count - 1
		arg_10_0.dic[arg_10_1] = nil
	end
end

function RenderMgr.update(arg_11_0, arg_11_1)
	for iter_11_0, iter_11_1 in pairs(arg_11_0.dic) do
		if iter_11_1 ~= nil then
			iter_11_1:update(arg_11_1)
		end
	end

	for iter_11_2, iter_11_3 in pairs(arg_11_0.funDic) do
		if iter_11_3 ~= nil then
			iter_11_3(arg_11_1)
		end
	end

	if #arg_11_0.next_do_list > 0 then
		local var_11_0 = table.remove(arg_11_0.next_do_list, 1)

		var_11_0[1](var_11_0[2])
	end
end

function RenderMgr.reportClock(arg_12_0)
	return
end

function RenderMgr.doNextFrame(arg_13_0, arg_13_1, arg_13_2)
	table.insert(arg_13_0.next_do_list, {
		arg_13_1,
		arg_13_2
	})
end

function RenderMgr.clear(arg_14_0)
	arg_14_0:stop()

	arg_14_0.cd_check = 0
	arg_14_0.count = 0
	arg_14_0.dic = {}
	arg_14_0.funDic = {}
	arg_14_0.next_do_list = {}
end
