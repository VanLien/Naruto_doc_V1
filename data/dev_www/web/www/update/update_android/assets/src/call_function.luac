function callFunc(arg_36_0, arg_36_1, arg_36_2, arg_36_3, arg_36_4)
	if not cc.GameDevice.callFunc then
		return ""
	end

	if arg_36_0 == nil or arg_36_0 == "" then
		return ""
	end

	arg_36_1 = arg_36_1 or ""
	arg_36_2 = arg_36_2 or 0
	arg_36_3 = arg_36_3 or 0
	arg_36_4 = arg_36_4 or ""

	return cc.GameDevice:callFunc(arg_36_0, arg_36_1, arg_36_2, arg_36_3, arg_36_4)
end
