-- --------------------------------------------------------------------
-- bug反馈
-- 
-- (必填, 创建模块的人员)
-- (必填, 后续维护以及修改的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: 2017-8-8
-- --------------------------------------------------------------------
RefundListWindow = RefundListWindow or BaseClass(BaseView)

local _controller = NoticeController:getInstance()
function RefundListWindow:__init()
    self.ctrl = NoticeController:getInstance()
    self.layout_name = "notice/refund_list_window"
    self.view_tag = ViewMgrTag.DIALOGUE_TAG  
    self.win_type = WinType.Mini
    self.btn_list = {}
    self.label_list = {}
    self.title_str = TI18N("语言_c_5036")
    self.content_str = ""
    self.cur_select = nil
end

function RefundListWindow:open_callback()
    -- -- self.root_wnd = 
    local bg = self.root_wnd:getChildByName("backpanel")
    bg:setScale(display.getMaxScale())
    self.background = bg:getChildByName("background")
    self.main_panel = self.root_wnd:getChildByName("main_panel")
    self:playEnterAnimatianByObj(self.main_panel , 2) 
    self.close_btn = self.main_panel:getChildByName("close_btn")
    self.close_btn:setVisible(false)
    self.top_panel = self.main_panel:getChildByName("top_panel")
    self.title_label = self.top_panel:getChildByName("title_label")
    self.titlebg = self.top_panel:getChildByName("title")

    self.title_label:setString(TI18N("语言_c_5036"))
    local bwidth = self.title_label:getContentSize().width + 140
    local bheight = self.titlebg:getContentSize().height
    self.titlebg:setContentSize(cc.size(bwidth,bheight))
    
    self.ok_btn = self.main_panel:getChildByName("ok_btn")
    self.ok_btn:setTitleText(TI18N("语言_c_3507"))
    self.ok_btn.label = self.ok_btn:getTitleRenderer()
    if self.ok_btn.label ~= nil then
        self.ok_btn.label:enableOutline(Config.ColorData.data_color4[264], 2)
    end
    self.Image_1 = self.main_panel:getChildByName("Image_1")

    self.txt_tip1 = self.main_panel:getChildByName("txt_tip1")
    self.txt_tip1:setString(TI18N("语言_c_5042"))
    self.txt_tip1:setTextAreaSize(cc.size(240,0))
    setTextSpacing(self.txt_tip1)
    self.txt_tip2 = self.main_panel:getChildByName("txt_tip2")
    self.txt_tip2:setString(TI18N("语言_c_5043"))
    self.txt_tip2:setTextAreaSize(cc.size(120,0))
    setTextSpacing(self.txt_tip2)
    self.txt_tip3 = self.main_panel:getChildByName("txt_tip3")
    self.txt_tip3:setString(TI18N("语言_c_5044"))
    self.txt_tip3:setTextAreaSize(cc.size(120,0))
    setTextSpacing(self.txt_tip3)

    -- Image_1
    
    -- local bwidth = self.title_label:getContentSize().height + 140

    self.tip_list = self.main_panel:getChildByName("tip_list")
    if self.item_scrollview == nil then
        local scroll_view_size = self.tip_list:getContentSize()
        local setting = {
            item_class = RefundListItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 10,                   -- y方向的间隔
            item_width = 580,               -- 单元的尺寸width
            item_height = 50,              -- 单元的尺寸height
            row = 0,                        -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            scale = 1
        }
        self.item_scrollview = CommonScrollViewLayout.new(self.tip_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
    end
    self:updateData()
end

function RefundListWindow:updateData()
    local model = _controller:getModel()
    local n_refundData = model:getRefundInfoData()
    if n_refundData then
        local rlist = n_refundData.lists or {}
        self.item_scrollview:setData(rlist)
    end
end

function RefundListWindow:register_event()
    self.ok_btn:addTouchEventListener(function(sender, event_type) 
        if event_type == ccui.TouchEventType.ended then
            playButtonSound2()
            self.ctrl:openRefundListWindow(false)
        end
    end)

    self:addGlobalEvent(NoticeEvent.Get_Refund_Info_Event_Data, function(data) --评价成功
        self:updateData()
    end)
end


function RefundListWindow:close_callback()
    doStopAllActions(self.main_panel)
    self.ctrl:openRefundListWindow(false)
end

-- --------------------------------------------------------------------
-- (必填, 创建模块的人员)
-- @description:
--      这里填写详细说明,主要填写该模块的功能简要
-- <br/>Create: new Date().toISOString()
--
-- --------------------------------------------------------------------
RefundListItem = class("RefundListItem", function()
    return ccui.Layout:create()
end)

function RefundListItem:ctor()
    self:setContentSize(cc.size(580, 50))
    -- self:setAnchorPoint(cc.p(0.5, 0.5))

    
    self.txt_key = createRichLabel(24, cc.c4b(0x64,0x32,0x23,0xff), cc.p(0,0.5), cc.p(12,25), nil, nil, 280)
    self.txt_key:setString("---")
    self:addChild(self.txt_key)
    
    self.txt_num = createRichLabel(24, cc.c4b(0x64,0x32,0x23,0xff), cc.p(0.5,0.5), cc.p(365,25), nil, nil, 200)
    self.txt_num:setString(TI18N("语言_c_5045"))
    self:addChild(self.txt_num)

    self.txt_state = createRichLabel(24, cc.c4b(0x64,0x32,0x23,0xff), cc.p(1,0.5), cc.p(572,25), nil, nil, 200)
    self.txt_state:setString(TI18N("语言_c_5045"))
    self:addChild(self.txt_state)
        
    self:registerEvent()
end

function RefundListItem:registerEvent()

end

function RefundListItem:setData(data)
    self.data = data
    if data then
        self.txt_key:setString(data.third_sn)
        self.txt_num:setString(string.format(TI18N("语言_c_4440"),data.money))
        if data.status == 2 then
            self.txt_state:setString(TI18N("语言_c_5045"))
        else
            self.txt_state:setString(TI18N("语言_c_5046"))
        end
    end
end

function RefundListItem:suspendAllActions()
end

function RefundListItem:DeleteMe()
    self:removeAllChildren()
    self:removeFromParent()
end