-- -------------------partner_show_start-------------------
Config.PartnerData.data_partner_show_length = 287
Config.PartnerData.data_partner_show_cache = {}
Config.PartnerData.data_partner_show = function(key)
	if Config.PartnerData.data_partner_show_cache[key] == nil then
		local base = Config.PartnerData.data_partner_show_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerData.data_partner_show_cache[key] = {
			bid = base[1],
			lev = base[2],
			star = base[3],
			atk = base[4],
			def = base[5],
			hp = base[6],
			speed = base[7],
			crit_rate = base[8],
			crit_ratio = base[9],
			hit_magic = base[10],
			dodge_magic = base[11],
			tenacity = base[12],
			hit_rate = base[13],
			res = base[14],
			dodge_rate = base[15],
			cure = base[16],
			be_cure = base[17],
			dam = base[18],
			skills = base[19],
		}
	end
	return Config.PartnerData.data_partner_show_cache[key] 
end
