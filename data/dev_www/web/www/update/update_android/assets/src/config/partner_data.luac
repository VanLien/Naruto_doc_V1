Config.PartnerData.data_partner_star_step_length = 400
Config.PartnerData.data_partner_star_step_cache = {}
Config.PartnerData.data_partner_star_step = function(key)
	if Config.PartnerData.data_partner_star_step_cache[key] == nil then
		local base = Config.PartnerData.data_partner_star_step_table[key]
		if not base then return end
		base = loadstring(string.format('return %s',base))()
		if not base then return end
		Config.PartnerData.data_partner_star_step_cache[key] = {
			bid = base[1],
			star = base[2],
			star_step = base[3],
			add_hp = base[4],
			add_atk = base[5],
			add_def = base[6],
			add_speed = base[7],
			lev_max_up = base[8],
			talent_pos = base[9],
			attr_show = base[10],
			expend1 = base[11],
			expend2 = base[12],
			expend3 = base[13],
			other_expend = base[14],
			is_second = base[15],
			expend1_2 = base[16],
			expend2_2 = base[17],
			expend3_2 = base[18],
			other_expend_2 = base[19],
			add_hp_c = base[20],
			add_atk_c = base[21],
			add_def_c = base[22],
			add_speed_c = base[23],
		}
	end
	return Config.PartnerData.data_partner_star_step_cache[key] 
end
