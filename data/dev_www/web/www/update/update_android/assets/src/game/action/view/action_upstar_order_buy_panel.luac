--******** 文件说明 ********
-- 
-- @description: 购买进阶卡
-- @DateTime:    2020-02-20
-- *******************************
ActionUpStarOrderBuyPanel = ActionUpStarOrderBuyPanel or BaseClass(BaseView)

local controller = ActionController:getInstance()
local model = controller:getModel()
local config = Config.HolidayGetninjaData
function ActionUpStarOrderBuyPanel:__init()
    self.is_full_screen = true
    self.win_type = WinType.Mini
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.layout_name = "action/action_upstar_order_untie_window"
end

function ActionUpStarOrderBuyPanel:open_callback()
    self.background = self.root_wnd:getChildByName("background")
    self.background:setScale(display.getMaxScale())
    local main_container = self.root_wnd:getChildByName("main_container")
    self:playEnterAnimatianByObj(main_container , 2) 

    local config = Config.HolidayStarplanOrderData.data_holiday_const
    self.title = main_container:getChildByName("Text_3")
    
    local text_bg = main_container:getChildByName("text_bg")
    self.Text_3_0 = main_container:getChildByName("Text_3_0")
    text_bg:setContentSize(cc.size(500,20))
    self.Text_3_1 = main_container:getChildByName("Text_3_1")
    self.Text_3_1_0 = main_container:getChildByName("Text_3_1_0")

    self.btn_change = main_container:getChildByName("btn_change")
    self.btn_change_label = self.btn_change:getChildByName("Text_6")

    self.goods_1 = main_container:getChildByName("goods_1")
    self.goods_1:setScrollBarEnabled(false)
    self.goods_2 = main_container:getChildByName("goods_2")
    self.goods_2:setScrollBarEnabled(false)
    local image_bg = main_container:getChildByName("Sprite_1")
    -- local res = PathTool.getPlistImgForDownLoad("get_ninja", "getninjaorder_banner_1")
    if not self.image_bg_load then
        self.image_bg_load = loadSpriteTextureFromCDN(image_bg, res, ResourcesType.single, self.image_bg_load)
    end
    self.btn_close = main_container:getChildByName("btn_close")

    self.label_lock = createRichLabel(22, cc.c4b(0x2b, 0x19, 0x5e, 0xff), cc.p(0.5, 0.5), cc.p(325, 136), -8, nil, 400)
    main_container:addChild(self.label_lock)
end

function ActionUpStarOrderBuyPanel:setData()
    local card_list = Config.HolidayStarplanOrderData.data_holiday_const[self.bid]
    self.title:setString(card_list.order_name)
    local main_container = self.root_wnd:getChildByName("main_container")
    local title_bg = main_container:getChildByName("title_bg")
    local title_width = main_container:getChildByName("Text_3"):getContentSize().width
    local title_bg_width = math.max(title_width+130, 266)
    title_bg:setContentSize(cc.size(title_bg_width,44))

    self.Text_3_0:setString(card_list.order_title1)
    self.Text_3_0:ignoreContentAdaptWithSize(true)
    self.Text_3_0:setTextAreaSize(cc.size(270,0))  
    setTextSpacing(self.Text_3_0,-6)
    self.Text_3_1_0:setString(card_list.order_title2)
    self.Text_3_1_0:ignoreContentAdaptWithSize(true)
    self.Text_3_1_0:setTextAreaSize(cc.size(340,0))
    setTextSpacing(self.Text_3_1,-6)
    self.Text_3_1:setString(card_list.order_title3)
    self.Text_3_1:ignoreContentAdaptWithSize(true)
    self.Text_3_1:setTextAreaSize(cc.size(260,0))
    setTextSpacing(self.Text_3_1,-6)
    local posY = self.Text_3_1_0:getPositionY() - self.Text_3_1_0:getContentSize().height / 2 - 16
    self.Text_3_1:setPositionY(posY)
    local str = card_list.order_title4
    self.label_lock:setString(str)
    
    if card_list then
        --可立即领取的奖励
        local data_list = card_list.rmb_reward or {}
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list1 = commonShowSingleRowItemList(self.goods_1, self.item_list1, data_list, setting)
        --升级奖励
        local temp_list = model:getUpStarOrderDataById(self.bid) or {}
        local data_list = deepCopy(temp_list)
        local item_list = {}
        for key, value in ipairs(data_list.award_list) do
            for i, v in ipairs(value.awards2) do
                table.insert(item_list,v)
            end
        end
        --合并去重
        local newList = {}
        for index, value in ipairs(item_list) do
            local itemid = value.item_id
            local itemnum = value.item_count
            local temp = false
            if tableLen(newList) > 0 then
                for i, v in ipairs(newList) do
                    if v.item_id == itemid then
                        v.item_count = v.item_count + itemnum
                        temp = true
                    end
                end
                if not temp then
                    table.insert(newList,value)
                end
            else
                table.insert(newList,value)
            end
        end
        --数据重组
        local new_array = {}
        for index, value in ipairs(newList) do
            local a = {}
            table.insert(a,value.item_id)
            table.insert(a,value.item_count)
            table.insert(new_array,a)
        end
        local setting = {}
        setting.scale = 0.7
        setting.space_x = 3
        setting.max_count = 4
        setting.is_center = true
        self.item_list2 = commonShowSingleRowItemList(self.goods_2, self.item_list2, new_array, setting)

        local charge_list = Config.ChargeData.data_charge_data
        local charge_id = card_list.charge_id or nil
        local flag = data_list.flag
        if flag == 1 then
            setChildUnEnabled(true,self.btn_change)
            self.btn_change:setTouchEnabled(false)
            self.btn_change_label:setString(TI18N("语言_c_210"))
        else
            if charge_id and charge_list[charge_id] then
                self.btn_change_label:setString(string.format(TI18N("语言_c_4441"),GetMoneyNum(charge_list[charge_id],"val")))
            end
        end
    end
end
function ActionUpStarOrderBuyPanel:update_btn(flag)
    if flag == 1 then
        setChildUnEnabled(true,self.btn_change)
        self.btn_change:setTouchEnabled(false)
        self.btn_change_label:setString(TI18N("语言_c_210"))
    end
end
function ActionUpStarOrderBuyPanel:register_event()
    registerButtonEventListener(
        self.background,
        function()
            controller:openBuyCardView(false)
        end,
        false,
        2
    )
    registerButtonEventListener(
        self.btn_close,
        function()
            controller:openBuyCardView(false)
        end,
        true,
        2
    )

    registerButtonEventListener( self.btn_change,
        function()
            self:changeWarn()
        end,
        true,1
    )
    if not self.skin_buy_event then
        self.skin_buy_event = GlobalEvent:getInstance():Bind(ActionEvent.UpStarOrder, function(data)
            if data and data.flag then
                self:update_btn(data.flag)
            end
        end)
    end
end

function ActionUpStarOrderBuyPanel:changeWarn()
    local charge_list = Config.ChargeData.data_charge_data
    local card_list = Config.HolidayStarplanOrderData.data_holiday_const[self.bid]
    local charge_id = card_list.charge_id or nil
    if charge_id and charge_list[charge_id] then
        local config = charge_list[charge_id]
        sdkOnPay(config.val, nil, config.id, config.name)
    end
end

function ActionUpStarOrderBuyPanel:openRootWnd(id)
    self.bid = id
    self:setData()
end

function ActionUpStarOrderBuyPanel:close_callback()
    if self.image_bg_load then
        self.image_bg_load:DeleteMe()
    end
    self.image_bg_load = nil
    if self.item_list1 then
        for i, v in pairs(self.item_list1) do
            v:DeleteMe()
        end
        self.item_list1 = nil
    end
    if self.item_list2 then
        for i, v in pairs(self.item_list2) do
            v:DeleteMe()
        end
        self.item_list2 = nil
    end
    if self.skin_buy_event then
        GlobalEvent:getInstance():UnBind(self.skin_buy_event)
        self.skin_buy_event = nil
    end
    controller:openBuyCardView(false)
end
