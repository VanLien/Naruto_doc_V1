	[571901] = [[{571901, "普通攻击", "莫凡", 57190, 0, 1, 1, 0, "active_skill", 0, 0, 1, 1, {5719001}, {}, 0, "对前方单体造成100%魔法伤害", "", "", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[571603] = [[{571603, "霹雳夜叉", "莫凡", 57160, 0, 3, 0, 4, "active_skill", 0, "min_hp_per", 1, 1, {5716003,5716023,5716031}, {}, 0, "随机召唤3-5道雷电劈向敌方剩余生命最低的单位每道雷造成95%魔法伤害且无视目标40%防御第一道雷有43%概率对目标附加持续2回合的【麻痹】对其他随机3个单位造成70%攻击力的溅射伤害且有10%概率附加【麻痹】；随后自身获得2层【精魄】（持续3回合最多叠加5层和【烈拳九宫】共享上限）", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "", "24483", 0, 1, 1, {{29823,21401}}, 0, 0, 2, 300}]],
	[571602] = [[{571602, "霹雳夜叉", "莫凡", 57160, 571603, 2, 0, 4, "active_skill", 0, "min_hp_per", 1, 1, {5716002,5716022,5716031}, {}, 0, "随机召唤3-5道雷电劈向敌方剩余生命最低的单位每道雷造成74%魔法伤害且无视目标30%防御第一道雷有37%概率对目标附加持续2回合的【麻痹】对其他随机3个单位造成60%攻击力的溅射伤害且有10%概率附加【麻痹】；随后自身获得2层【精魄】（持续3回合最多叠加5层和【烈拳九宫】共享上限）", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "24483", 0, 1, 1, {{29822,21401}}, 0, 0, 2, 200}]],
	[571601] = [[{571601, "霹雳夜叉", "莫凡", 57160, 571602, 1, 0, 4, "active_skill", 0, "min_hp_per", 1, 1, {5716001,5716021,5716031}, {}, 0, "随机召唤3-5道雷电劈向敌方剩余生命最低的单位每道雷造成62%魔法伤害且无视目标20%防御第一道雷有33%概率对目标附加持续2回合的【麻痹】对其他随机3个单位造成50%攻击力的溅射伤害且有10%概率附加【麻痹】；随后自身获得2层【精魄】（持续3回合最多叠加5层和【烈拳九宫】共享上限）", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24483", 0, 1, 1, {{29821,21401}}, 0, 0, 2, 100}]],
	[571503] = [[{571503, "烈拳九宫", "莫凡", 57150, 0, 3, 0, 2, "active_skill", 0, 0, 1, 1, {5715003,5715013,5715023,5715033,5715043,5715053}, {}, 0, "火焰包裹双拳冲向敌方对前中排全体单位造成104%魔法伤害并有50%概率对其附加持续1回合的【受疗下降80%】随后火焰从地面涌出对敌方全体造成82%魔法伤害且有70%概率降低其30%闪避和15%攻击持续2回合每段伤害均有80%概率附加【灼烧】；随后自身获得【火灵护盾】与1层【精魄】（持续3回合最多叠加5层和【霹雳夜叉】共享上限）", "初始激活", "", "24201", 0, 1, 1, {{21205}}, 0, 0, 1, 300}]],
	[571502] = [[{571502, "烈拳九宫", "莫凡", 57150, 571503, 2, 0, 2, "active_skill", 0, 0, 1, 1, {5715002,5715012,5715022,5715032,5715042,5715052}, {}, 0, "火焰包裹双拳冲向敌方对前中排全体单位造成85%魔法伤害并有40%概率对其附加持续1回合的【受疗下降80%】随后火焰从地面涌出对敌方全体造成70%魔法伤害且有70%概率降低其20%闪避和10%攻击持续2回合每段伤害均有70%概率附加【灼烧】；随后自身获得【火灵护盾】与1层【精魄】（持续3回合最多叠加5层和【霹雳夜叉】共享上限）", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "24201", 0, 1, 1, {{21205}}, 0, 0, 1, 200}]],
	[571501] = [[{571501, "烈拳九宫", "莫凡", 57150, 571502, 1, 0, 2, "active_skill", 0, 0, 1, 1, {5715001,5715011,5715021,5715031,5715041,5715051}, {}, 0, "火焰包裹双拳冲向敌方对前中排全体单位造成66%魔法伤害并有30%概率对其附加持续1回合的【受疗下降80%】随后火焰从地面涌出对敌方全体造成58%魔法伤害且有70%概率降低其10%闪避和5%攻击持续2回合每段伤害均有60%概率附加【灼烧】；随后自身获得【火灵护盾】与1层【精魄】（持续3回合最多叠加5层和【霹雳夜叉】共享上限）", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24201", 0, 1, 1, {}, 0, 0, 1, 100}]],
	[571414] = [[{571414, "复活", "莫凡", 57142, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {5714041}, {}, 0, "莫凡死亡时心有不干，有30%几率以30%的血量返回战场", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "", "24634", 0, 1, 1, {{95211,20073,571413}}, 0, 0, 0, 0}]],
	[571413] = [[{571413, "魔怒", "莫凡", 57141, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {5714113}, {}, 0, "队伍造成暴击时为莫凡为自己增加3层【魔怒】和【伤害减免】", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "", "24634", 0, 1, 1, {{95211,20073,571413}}, 0, 0, 0, 0}]],
	[571412] = [[{571412, "魔怒", "莫凡", 57141, 571413, 2, 0, 0, "passive_skill", 0, 0, 5, 1, {5714112}, {}, 0, "队伍造成暴击时为莫凡为自己增加2层【魔怒】和【伤害减免】", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>10星</div>自动升级", "24634", 0, 1, 1, {{95211,20072,571412}}, 0, 0, 0, 0}]],
	[571411] = [[{571411, "魔怒", "莫凡", 57141, 571412, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {5714111}, {}, 0, "队伍造成暴击时为莫凡为自己增加1层【魔怒】和【伤害减免】", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24634", 0, 1, 1, {{95211,20071,571411}}, 0, 0, 0, 0}]],
	[571403] = [[{571403, "Mẫn bóng sói", "Mạc Phàm", 57140, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {5714003,5714011,5714021}, {}, 0, "Khi sinh lực của bạn giảm xuống dưới 50% lần đầu tiên trong trận chiến, bạn sẽ biến thành [Ác ma hình thái] và kết hợp máu để phục hồi 40% sinh lực và nhận ngay 10 lớp [Tinh phách] (tối đa 10 lớp, tồn tại vĩnh viễn)；", "", "", "24634", 0, 1, 0, {{95211,20073}}, 0, 0, 0, 0}]],
	[571402] = [[{571402, "Mẫn bóng sói", "Mạc Phàm", 57140, 571403, 2, 0, 0, "passive_skill", 0, 0, 5, 1, {5714002,5714011,5714021}, {}, 0, "Khi sinh lực của bạn giảm xuống dưới 50% lần đầu tiên trong trận chiến, bạn sẽ biến thành [Ác ma hình thái] và kết hợp máu để phục hồi 40% sinh lực và nhận ngay 10 lớp [Tinh phách] (tối đa 10 lớp, tồn tại vĩnh viễn)；", "升级条件：英雄到达<div fontcolor=45a536>10星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>10星</div>自动升级", "24634", 0, 1, 0, {{95211,20072}}, 0, 0, 0, 0}]],
	[571401] = [[{571401, "Mẫn bóng sói", "Mạc Phàm", 57140, 571402, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {5714001,5714011,5714021}, {}, 0, "Khi sinh lực của bạn giảm xuống dưới 50% lần đầu tiên trong trận chiến, bạn sẽ biến thành [Ác ma hình thái] và kết hợp máu để phục hồi 40% sinh lực và nhận ngay 10 lớp [Tinh phách] (tối đa 10 lớp, tồn tại vĩnh viễn)；", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24634", 0, 1, 0, {{95211,20071}}, 0, 0, 0, 0}]],
	[571303] = [[{571303, "Lôi Ấn nộ kích", "Mạc Phàm", 57130, 0, 3, 0, 4, "active_skill", 0, 0, 1, 1, {5713003}, {}, 0, "Triệu hồi ngẫu nhiên 3-7 tia sét tấn công toàn bộ kẻ địch. Mỗi tia sét gây 95% sát thương phép và bỏ qua 10% phòng thủ của mục tiêu. Tia sét đầu tiên có 24% cơ hội cộng [Tê liệt] vào mục tiêu tồn tại trong 2 Xác suất thêm [Tê danh] vào đơn vị chậm hơn mình tăng lên 43%, theo [Ác ma hình thái] kỹ năng này được cường hóa thành [Phích lịch Dạ Xoa]", "", "", "24633", 0, 1, 1, {{95233,28101}}, 0, 0, 0, 0}]],
	[571302] = [[{571302, "Lôi Ấn nộ kích", "Mạc Phàm", 57130, 571303, 2, 0, 4, "active_skill", 0, 0, 1, 1, {5713002}, {}, 0, "Triệu hồi ngẫu nhiên 3-7 tia sét tấn công tất cả kẻ địch. Mỗi tia sét gây 74% sát thương phép và bỏ qua 7% phòng thủ của mục tiêu. Tia sét đầu tiên có 20% cơ hội cộng [Tê liệt] vào mục tiêu tồn tại trong 2 Xác suất thêm [Tê danh] vào đơn vị chậm hơn mình tăng lên 37%, theo [Ác ma hình thái] kỹ năng này được cường hóa thành [Phích lịch Dạ Xoa]", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "24633", 0, 1, 1, {{95232,28101}}, 0, 0, 0, 0}]],
	[571301] = [[{571301, "Lôi Ấn nộ kích", "Mạc Phàm", 57130, 571302, 1, 0, 4, "active_skill", 0, 0, 1, 1, {5713001}, {}, 0, "Triệu hồi ngẫu nhiên 3-5 tia sét tấn công toàn bộ kẻ địch. Mỗi tia sét gây 62% sát thương phép và bỏ qua 5% phòng ngự của mục tiêu. Tia sét đầu tiên có 16% cơ hội cộng [Tê liệt] vào mục tiêu tồn tại trong 2 Xác suất thêm [Tê danh] vào đơn vị chậm hơn mình tăng lên 33%, theo [Ác ma hình thái] kỹ năng này được cường hóa thành [Phích lịch Dạ Xoa]", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24633", 0, 1, 1, {{95231,28101}}, 0, 0, 0, 0}]],
	[571203] = [[{571203, "Độn ảnh", "Mạc Phàm", 57120, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {5712003}, {{'atk_per',400},{'hp_max_per',200},{'crit_ratio',300}}, 0, "Tấn công tăng 40%, sinh mệnh tăng 20% ​​và sát thương chí mạng tăng 30%; Mạc Phàm trốn vào bóng tối và không thể kích hoạt [Liên kết ma thuật] khi tấn công, nhưng khi mỗi đòn tấn công gây sát thương, anh ta sẽ tăng tốc độ của mình lên một thêm 1% và 3%.Tỉ lệ chí mạng, mỗi đòn có thể cộng dồn tối đa 10 lần, kéo dài 2 hiệp.", "", "", "24632", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[571202] = [[{571202, "Độn ảnh", "Mạc Phàm", 57120, 571203, 2, 0, 0, "passive_skill", 0, 0, 5, 1, {5712002}, {{'atk_per',300},{'hp_max_per',150},{'crit_ratio',200}}, 0, "Đòn tấn công tăng 30%, sinh mệnh tăng 15% và sát thương chí mạng tăng 20%; Mạc Phàm trốn vào bóng tối và không thể kích hoạt [Liên kết ma thuật] khi tấn công, nhưng khi mỗi đòn tấn công gây ra sát thương, Tốc độ của bản thân sẽ được tăng thêm 1% và 3%, tỷ lệ chí mạng, mỗi đòn có thể cộng dồn tối đa 7 lần, kéo dài 2 hiệp.", "升级条件：英雄到达<div fontcolor=45a536>8星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>8星</div>自动升级", "24632", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[571201] = [[{571201, "Độn ảnh", "Mạc Phàm", 57120, 571202, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {5712001}, {{'atk_per',200},{'hp_max_per',100},{'crit_ratio',100}}, 0, "Tấn công tăng 20%, sinh mệnh tăng 10% và sát thương chí mạng tăng 10%; Mạc Phàm trốn vào bóng tối và không thể kích hoạt [Liên kết ma thuật] khi tấn công, nhưng khi mỗi đòn tấn công gây sát thương, anh ta sẽ tăng tốc độ của bản thân tăng thêm 1% và 3%. Tỷ lệ chí mạng, mỗi đòn có thể cộng dồn tối đa 5 lần, kéo dài 2 lượt.", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24632", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[571121] = [[{571121, "火灵护盾", "莫凡", 57111, 0, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {5711201}, {}, 0, "受到攻击时对攻击方附加1层持续1回合的【烈焰灼烧】", "", "", "", 0, 1, 1, {}, 0, 0, 0, 0}]],
