	[558503] = [[{558503, "诡咒迷魂", "孟婆", 55850, 0, 3, 0, 4, "passive_skill", 0, 0, 1, 1, {5585033}, {}, 0, "孟婆对敌方全体造成150%攻击力的魔法伤害【35%+7%*我方暗系英雄数量】概率驱散目标携带的所有增益效果每驱散1层转化为1层【迷魂】最多转化5层；释放此技能后使我方单位在攻击携带【迷魂】的敌方单位时有60%概率对其附加1层【诅咒】此效果持续2回合", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "", "24483", 0, 1, 0, {}, 0, 0, 0, 0}]],
	[558502] = [[{558502, "诡咒迷魂", "孟婆", 55850, 558503, 2, 0, 4, "passive_skill", 0, 0, 1, 1, {5585032}, {}, 0, "孟婆对敌方全体造成125%攻击力的魔法伤害【25%+6%*我方暗系英雄数量】概率驱散目标携带的所有增益效果每驱散1层转化为1层【迷魂】最多转化4层；释放此技能后使我方单位在攻击携带【迷魂】的敌方单位时有50%概率对其附加1层【诅咒】此效果持续2回合", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "24483", 0, 1, 0, {}, 0, 0, 0, 0}]],

	[558803] = [[{558803, "回魂祝梦", "被动", 55880, 0, 3, 0, 0, "passive_skill", 0, 0, 2, 1, {5588003}, {}, 0, "死亡时化作无常小鬼并在死亡后的第5回合以40%生命复活；此效果最多持续4回合且不可驱散（受【驱灵】影响与【圣灵】效果不叠加）", "", "", "24484", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[558802] = [[{558802, "回魂祝梦", "被动", 55880, 558803, 2, 0, 0, "passive_skill", 0, 0, 2, 1, {5588002}, {}, 0, "死亡时化作无常小鬼并在死亡后的第5回合以40%生命复活；此效果最多持续4回合且不可驱散（受【驱灵】影响与【圣灵】效果不叠加）", "", "", "24484", 0, 1, 1, {}, 0, 0, 0, 0}]],
