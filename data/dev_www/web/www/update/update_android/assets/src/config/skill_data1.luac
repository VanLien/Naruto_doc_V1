	[905303] = [[{905303, "Loa Hoàn Toàn Cao Cấp", "Boruto Momoshiki Ego", 90530, 0, 3, 0, 4, "active_skill", 0, 0, 1, 1, {9053003,9053013}, {}, 0, "Boruto Momoshiki Ego nén sức mạnh ma thuật của gió  gây ra sát thương nổ cực lớn, gây 153% sát thương phép cho tất cả kẻ địch, giảm ngẫu nhiên 15% tỷ lệ khống chế của 2 đơn vị và tạo thành [Vòng tròn phép thuật gió] lên kẻ địch kéo dài trong 2 lượt", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "", "90530", 0, 0, 1, {{296030,23413}}, 0, 0, 2, 0}]],
	[905302] = [[{905302, "Loa Hoàn Toàn Cao Cấp", "Boruto Momoshiki Ego", 90530, 905303, 2, 0, 4, "active_skill", 0, 0, 1, 1, {9053002,9053012}, {}, 0, "Boruto Momoshiki Ego nén sức mạnh ma thuật của gió  gây ra sát thương bùng nổ cực lớn và 127% sát thương phép cho tất cả kẻ địch. Nó ngẫu nhiên giảm 10% khả năng kiểm soát của một đơn vị và tạo thành [Vòng tròn phép thuật gió] lên kẻ địch. kéo dài trong 2 lượt", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "90530", 0, 0, 1, {{296020,23412}}, 0, 0, 2, 0}]],
	[905301] = [[{905301, "Loa Hoàn Toàn Cao Cấp", "Boruto Momoshiki Ego", 90530, 905302, 1, 0, 4, "active_skill", 0, 0, 1, 1, {9053001,9053011}, {}, 0, "Boruto Momoshiki Ego nén sức mạnh ma thuật của gió  gây ra sát thương nổ cực lớn, gây 105% sát thương phép cho tất cả kẻ địch và tạo thành [Vòng tròn phép thuật gió] trên kẻ địch tồn tại trong 2 lượt", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "90530", 0, 0, 1, {{296010}}, 0, 0, 2, 0}]],
	[905203] = [[{905203, "Bạch Nhãn", "Boruto Momoshiki Ego", 90520, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {9052003}, {{'atk_per',400},{'hp_max_per',200},{'speed',30}}, 0, "Boruto Momoshiki Ego thành thạo ma thuật gió, tăng 40% tấn công, 20% máu và 30 tốc độ. Khi các đơn vị khác trong đội có hiệu ứng tăng tốc, Boruto Momoshiki Ego sẽ xếp chồng 1 lớp [ khả năng lãnh đạo] (mỗi đơn vị có nhiều hiệu ứng tăng tốc thì  chỉ tính 1 lần). Mỗi lớp tăng tốc độ của bản thân thêm 2% và tấn công thêm 4%. có thể được xếp chồng lên tới 5 lớp.", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "", "90520", 0, 0, 0, {{16103}}, 0, 0, 0, 0}]],
	[905202] = [[{905202, "Bạch Nhãn", "Boruto Momoshiki Ego", 90520, 905203, 2, 0, 0, "passive_skill", 0, 0, 5, 1, {9052002}, {{'atk_per',300},{'hp_max_per',150},{'speed',20}}, 0, "Boruto Momoshiki Ego thành thạo ma thuật gió, tăng 30% tấn công, 15% máu và 20 tốc độ. Khi các đơn vị khác trong đội có hiệu ứng tăng tốc, Boruto Momoshiki Ego sẽ xếp chồng 1 lớp [ khả năng lãnh đạo] (mỗi đơn vị có nhiều hiệu ứng tăng tốc thì  chỉ tính 1 lần). Mỗi lớp tăng tốc độ của bản thân thêm 1% và tấn công thêm 3%. có thể được xếp chồng lên tới 5 lớp.", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>8星</div>自动升级", "90520", 0, 0, 0, {{16102}}, 0, 0, 0, 0}]],
	[905201] = [[{905201, "Bạch Nhãn", "Boruto Momoshiki Ego", 90520, 905202, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {9052001}, {{'atk_per',200},{'hp_max_per',100},{'speed',10}}, 0, "Boruto Momoshiki Ego thành thạo phép thuật gió, tăng 20% ​​tấn công, 10% máu và 10 tốc độ. Khi các đơn vị khác trong đội có hiệu ứng tăng tốc, Boruto Momoshiki Ego sẽ xếp chồng 1 lớp [ khả năng lãnh đạo] (mỗi đơn vị có nhiều hiệu ứng tăng tốc thì  chỉ tính 1 lần). Mỗi lớp tăng tốc độ của bản thân thêm 1% và tấn công thêm 2%. có thể được xếp chồng lên tới 5 lớp.", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "90520", 0, 0, 0, {{16101}}, 0, 0, 0, 0}]],
	[905103] = [[{905103, "Cao Hoàng Sản Linh Tôn", "Boruto Momoshiki Ego", 90510, 0, 3, 0, 2, "active_skill", 0, 0, 1, 1, {9051003,9051013}, {}, 0, "Phép thuật tác động bạo lực, gây 162% sát thương phép cho hàng dọc và có thêm 70% cơ hội thêm [phong thuật lồng] và [Phá Giáp] vào một đơn vị ngẫu nhiên, cả hai đều tồn tại trong 2 hiệp, nếu đơn vị có tốc độ chậm hơn bản thân , khi đó xác suất bổ sung được tăng lên 100%", "初始激活", "", "90510", 0, 0, 1, {{29503,22104}}, 0, 0, 1, 0}]],
	[905102] = [[{905102, "Cao Hoàng Sản Linh Tôn", "Boruto Momoshiki Ego", 90510, 905103, 2, 0, 2, "active_skill", 0, 0, 1, 1, {9051002,9051012}, {}, 0, "Phép thuật tác động dữ dội, gây 135% sát thương phép cho hàng dọc và có thêm 60% cơ hội thêm [phong thuật lồng] và [Phá giáp] vào một đơn vị ngẫu nhiên, cả hai đều tồn tại trong 2 hiệp.", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "90510", 0, 0, 1, {{29502,22103}}, 0, 0, 1, 0}]],
	[905101] = [[{905101, "Cao Hoàng Sản Linh Tôn", "Boruto Momoshiki Ego", 90510, 905102, 1, 0, 2, "active_skill", 0, 0, 1, 1, {9051001,9051011}, {}, 0, "Phép thuật tác động dữ dội, gây 113% sát thương phép cho hàng dọc  và có thêm 50% cơ hội thêm [phong thuật lồng] và [Phá Giáp] vào một đơn vị ngẫu nhiên, cả hai đều tồn tại trong 2 hiệp.", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "90510", 0, 0, 1, {{29501,22103}}, 0, 0, 1, 0}]],
	[905001] = [[{905001, "普通攻击", "Boruto Momoshiki Ego", 90500, 0, 1, 1, 0, "active_skill", 0, 0, 1, 1, {9050001}, {}, 0, "对前方单体造成100%物理伤害", "", "", "20000", 0, 0, 1, {}, 0, 0, 0, 0}]],

	[968901] = [[{968901, "跑打动作", "Asya Thiên mệnh", 96890, 0, 1, 1, 0, "active_skill", 0, 0, 1, 1, {9689001}, {}, 0, "Gây 100% sát thương phép lên mục tiêu phía trước", "", "", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968631] = [[{968631, "Địa tinh tách ra", "Asya Thiên mệnh", 96863, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9686301,9686331,9686341,9686321}, {}, 0, "Tiêu hao [Địa tinh] để gây 30% sát thương phép cho 3 kẻ địch ngẫu nhiên, có 40% xác suất thêm [Minh Thần Môn: Dịch Thương] Nếu mục tiêu có [Minh Thần Môn: Dịch Thương], có 50% xác suất thêm [Phong ấn] trong 1 hiệp", "初始激活", "", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968621] = [[{968621, "Địa tinh tách ra", "Asya Thiên mệnh", 96862, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9686201,9686231,9686221}, {}, 0, "Tiêu hao [Địa Tinh] để gây 25% sát thương phép cho 3 kẻ địch ngẫu nhiên, có 40% cơ hội thêm [Minh Thần Môn: Dịch Thương]", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968611] = [[{968611, "Địa tinh tách ra", "Asya Thiên mệnh", 96861, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9686101,9686131,9686121}, {}, 0, "Tiêu hao [Địa Tinh] để gây 20% sát thương phép cho 3 kẻ địch ngẫu nhiên, có 40% cơ hội thêm [Minh Thần Môn: Dịch Thương]", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968531] = [[{968531, "Thiên tinh giới phá", "Asya Thiên mệnh", 96853, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9685301,9685351,9685311,9685351,9685321,9685351,9685331,9685341}, {}, 0, "Tiêu hao [Thiên Tinh] để tấn công một mục tiêu ngẫu nhiên của kẻ địch trong 3 giai đoạn, gây ra tổng cộng 60% sát thương ma thuật và mỗi giai đoạn có 20% cơ hội tăng thêm [Minh Thần Môn: Dịch Thương] Nếu mục tiêu có [Thiên Tinh Minh Thần Môn: Dịch Thương], sát thương sẽ tăng 10%", "初始激活", "", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968521] = [[{968521, "Thiên tinh giới phá", "Asya Thiên mệnh", 96852, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9685201,9685251,9685211,9685251,9685221,9685251,9685241}, {}, 0, "Tiêu hao [Thiên Tinh] để tấn công một mục tiêu địch ngẫu nhiên trong 3 giai đoạn, gây ra tổng cộng 51% sát thương ma thuật và mỗi giai đoạn có 20% cơ hội tăng thêm [Minh Thần Môn: Dịch Thương]", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968511] = [[{968511, "Thiên tinh giới phá", "Asya Thiên mệnh", 96851, 0, 1, 0, 0, "active_skill", 0, 0, 1, 1, {9685101,9685151,9685111,9685151,9685121,9685151,9685141}, {}, 0, "Tiêu hao [Thiên Tinh] để tấn công ngẫu nhiên mục tiêu kẻ địch trong 3 giai đoạn, gây ra tổng cộng 45% sát thương phép thuật và mỗi giai đoạn có 20% cơ hội tăng thêm [Minh Thần Môn: Dịch Thương]", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "20000", 0, 1, 1, {}, 0, 0, 0, 0}]],
	[968404] = [[{968404, "nổ sao[魂]", "Asya Thiên mệnh", 96840, 0, 4, 0, 0, "passive_skill", 0, 0, 1, 1, {9684003,9684004}, {}, 0, "Trong biển sét, khi đòn tấn công gây sát thương, nếu mục tiêu có hiệu ứng [Tinh huy Minh Thần Môn: Dịch Thương] khác với [Minh Thần Môn: Dịch Thương], thì có 25% xác suất tăng thêm 1 lớp [Minh Thần Môn: Dịch Thương] cho mục tiêu, đồng thời có 50% cơ hội tăng sức mạnh cho phe mình. 2% sức tấn công và 2% sát thương chí mạng của tất cả các tướng hạng nhẹ kéo dài trong 2 lượt và có thể cộng dồn tối đa 5 lần", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "", "24614", 0, 1, 1, {{20921}}, 0, 0, 0, 0}]],
	[968403] = [[{968403, "nổ sao", "Asya Thiên mệnh", 96840, 0, 3, 0, 0, "passive_skill", 0, 0, 1, 1, {9684003}, {}, 0, "Trong biển sét, khi đòn tấn công gây sát thương, nếu mục tiêu có hiệu ứng [Tinh huy Minh Thần Môn: Dịch Thương] khác với [Minh Thần Môn: Dịch Thương], thì có 25% xác suất tăng thêm 1 lớp [Minh Thần Môn: Dịch Thương] cho mục tiêu.", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "", "24614", 0, 1, 1, {{20921}}, 0, 0, 0, 0}]],
	[968402] = [[{968402, "nổ sao", "Asya Thiên mệnh", 96840, 968403, 2, 0, 0, "passive_skill", 0, 0, 1, 1, {9684002}, {}, 0, "Trong biển sét, khi đòn tấn công gây sát thương, nếu mục tiêu có hiệu ứng [ Tinh huy Minh Thần Môn: Dịch Thương ] khác với [ Minh Thần Môn: Dịch Thương ], thì có 20% xác suất tăng thêm 1 lớp [ Minh Thần Môn: Dịch Thương ].", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>10星</div>自动升级", "24614", 0, 1, 1, {{20921}}, 0, 0, 0, 0}]],
	[968401] = [[{968401, "nổ sao", "Asya Thiên mệnh", 96840, 968402, 1, 0, 0, "passive_skill", 0, 0, 1, 1, {9684001}, {}, 0, "Trong biển sét, khi đòn tấn công gây sát thương, nếu mục tiêu có hiệu ứng [Tinh huy Minh Thần Môn: Dịch Thương] khác với [Minh Thần Môn: Dịch Thương], thì có 15% xác suất tăng thêm 1 lớp [Minh Thần Môn: Dịch Thương] cho mục tiêu.", "激活条件：英雄到达<div fontcolor=45a536>5阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24614", 0, 1, 1, {{20921}}, 0, 0, 0, 0}]],
	[968304] = [[{968304, "Tinh La Vạn Tượng[魂]", "Asya Thiên mệnh", 96830, 0, 4, 0, 0, "passive_skill", 0, 0, 1, 1, {9683003}, {}, 0, "sau khi đồng đội của bạn thực hiện một lượt đánh thông thường, nếu có một thiên thể trên vệt sao, thì có 70% cơ hội ngay lập tức tiêu thụ một [thiên thể] ngẫu nhiên mà bạn giữ để phóng ra một [Thiên tinh giới phá ] hoặc [Địa tinh tách ra] một lần. ; Nếu không có thiên thể, có 40% cơ hội ngẫu nhiên thêm 1 thiên thể", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "", "24613", 0, 1, 1, {{95173,95183,20902,22004}}, 0, 0, 0, 0}]],
	[968303] = [[{968303, "Tinh La Vạn Tượng", "Asya Thiên mệnh", 96830, 0, 3, 0, 0, "passive_skill", 0, 0, 1, 1, {9683003}, {}, 0, "sau khi đồng đội của bạn thực hiện một lượt đánh thông thường, nếu có một thiên thể trên vệt sao, thì có 70% cơ hội ngay lập tức tiêu thụ một [thiên thể] ngẫu nhiên mà bạn giữ để phóng ra một [Thiên tinh giới phá ] hoặc [Địa tinh tách ra] một lần. ; Nếu không có thiên thể, có 40% cơ hội ngẫu nhiên thêm 1 thiên thể", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "", "24613", 0, 1, 1, {{95173,95183,20902,22004}}, 0, 0, 0, 0}]],
	[968302] = [[{968302, "Tinh La Vạn Tượng", "Asya Thiên mệnh", 96830, 968303, 2, 0, 0, "passive_skill", 0, 0, 1, 1, {9683002}, {}, 0, "sau khi đồng đội của bạn thực hiện một lượt đánh thông thường, nếu có một thiên thể trên đường đua của các vì sao, thì có 65% cơ hội ngay lập tức tiêu thụ một [thiên thể] ngẫu nhiên mà bạn giữ để phóng ra một [Thiên tinh giới phá ] hoặc [Địa tinh tách ra] một lần. ; Nếu không có thiên thể, có 32% xác suất ngẫu nhiên thêm 1 thiên thể", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>9星</div>自动升级", "24613", 0, 1, 1, {{95172,95182,20902}}, 0, 0, 0, 0}]],
	[968301] = [[{968301, "Tinh La Vạn Tượng", "Asya Thiên mệnh", 96830, 968302, 1, 0, 0, "passive_skill", 0, 0, 1, 1, {9683001}, {}, 0, "sau khi đồng đội của bạn thực hiện một lượt đánh thông thường, nếu có một thiên thể trên đường đua của các vì sao, thì có 60% cơ hội sẽ ngay lập tức tiêu thụ một thiên thể mà bạn nắm giữ ngẫu nhiên[Thiên thể] phóng thích [Thiên tinh giới phá ] hoặc [Địa tinh tách ra] một lần; nếu không có thiên thể, có 25% cơ hội ngẫu nhiên thêm 1 thiên thể", "激活条件：英雄到达<div fontcolor=45a536>3阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24613", 0, 1, 1, {{95171,95181,20902}}, 0, 0, 0, 0}]],
	[968203] = [[{968203, "ngôi sao định mệnh", "Asya Thiên mệnh", 96820, 0, 3, 0, 0, "passive_skill", 0, 0, 5, 1, {9682003}, {{'atk_per',400},{'hp_max_per',200},{'crit_rate',150}}, 0, "Asiya được bao quanh bởi những vệt sao, và được các vì sao ban phước, tấn công tăng 40%, sinh mệnh  tăng 20% ​​và đòn chí mạng tăng 15% ,trước khi chủ động xuất chiêu trong lượt của mình, cô ấy sẽ thêm  2 [thiên thể], cụ thể là [sao trời] và [sao đất] ( Mỗi thiên thể chỉ có thể chứa tối đa 1)", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "", "24612", 0, 1, 1, {{19983,19993}}, 0, 0, 0, 0}]],
	[968202] = [[{968202, "ngôi sao định mệnh", "Asya Thiên mệnh", 96820, 968203, 2, 0, 0, "passive_skill", 0, 0, 5, 1, {9682002}, {{'atk_per',300},{'hp_max_per',150},{'crit_rate',100}}, 0, "Asiya được bao quanh bởi các vệt sao và được các vì sao ban phước, Tấn công tăng 30%, sinh mệnh tăng 15%, tấn công chí mạng tăng 10%, trước khi chủ động xuất chiêu trong lượt của mình, cô ấy sẽ tăng thêm 2 [thiên thể] , cụ thể là cụ thể là [sao trời] và [sao đất] (tối đa chỉ có thể chứa một)", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>8星</div>自动升级", "24612", 0, 1, 1, {{19982,19992}}, 0, 0, 0, 0}]],
	[968201] = [[{968201, "ngôi sao định mệnh", "Asya Thiên mệnh", 96820, 968202, 1, 0, 0, "passive_skill", 0, 0, 5, 1, {9682001}, {{'atk_per',200},{'hp_max_per',100},{'crit_rate',50}}, 0, "Asiya được bao quanh bởi những vệt sao và dưới sự ban phước của các vì sao, đ tấn công tăng 20%, sinh mệnh tăng 10%, đòn chí mạng của cô ấy tăng 5% ,và cô ấy sẽ thêm 2 [thiên thể] , cụ thể là [sao trời] và [sao đất]  (tối đa chỉ có thể giữ một cái)", "激活条件：英雄到达<div fontcolor=45a536>1阶</div>自动激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24612", 0, 1, 1, {{19981,19991}}, 0, 0, 0, 0}]],
	[968104] = [[{968104, "sao rơi[魂]", "Asya Thiên mệnh", 96810, 0, 4, 0, 2, "active_skill", 0, 0, 1, 1, {9681004,9681021,9681014,9681021,9681034}, {}, 0, "Asya sử dụng sức mạnh của các vì sao để tấn công 4 kẻ thù ngẫu nhiên trong 2 giai đoạn, gây ra tổng sát thương phép thuật là 250%, mỗi lần tấn công có 45% cơ hội thêm [Minh Thần Môn: Dịch Thương] nếu mục tiêu đang ở trạng thái [Minh Thần Môn: Dịch Thương] khi tấn công .72% cơ hội thêm [sát thương phép thuật tăng 10%] trong 2 lượt", "初始激活", "", "24611", 0, 1, 1, {{20902,21602}}, 0, 1, 0, 0}]],
	[968103] = [[{968103, "sao rơi", "Asya Thiên mệnh", 96810, 0, 3, 0, 2, "active_skill", 0, 0, 1, 1, {9681003,9681021,9681013,9681021,9681033}, {}, 0, "Asya sử dụng sức mạnh của các vì sao để tấn công 3 kẻ thù ngẫu nhiên trong 2 giai đoạn, gây ra tổng sát thương phép thuật là 230%, mỗi lần tấn công có 45% cơ hội thêm [Minh Thần Môn: Dịch Thương] nếu mục tiêu đang ở trạng thái [Minh Thần Môn: Dịch Thương] khi tấn công .72% cơ hội thêm [sát thương phép thuật tăng 10%] trong 2 lượt", "初始激活", "", "24611", 0, 1, 1, {{20902,21602}}, 0, 1, 0, 0}]],
	[968102] = [[{968102, "sao rơi", "Asya Thiên mệnh", 96810, 968103, 2, 0, 2, "active_skill", 0, 0, 1, 1, {9681002,9681021,9681012,9681021,9681032}, {}, 0, "Asya sử dụng sức mạnh của các vì sao để tấn công 3 kẻ thù ngẫu nhiên trong 2 giai đoạn, gây ra tổng sát thương phép thuật là 178%, mỗi lần tấn công có 45% cơ hội thêm [Minh Thần Môn: Dịch Thương] nếu mục tiêu có trạng thái [Minh Thần Môn: Dịch Thương] khi tấn công. 60 % cơ hội thêm [sát thương phép thuật tăng 10%] trong 2 lượt", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>7星</div>自动升级", "24611", 0, 1, 1, {{20902,21602}}, 0, 1, 0, 0}]],
	[968101] = [[{968101, "sao rơi", "Asya Thiên mệnh", 96810, 968102, 1, 0, 2, "active_skill", 0, 0, 1, 1, {9681001,9681021,9681011,9681021,9681031}, {}, 0, "Asya sử dụng sức mạnh của các vì sao để tấn công 3 kẻ thù ngẫu nhiên trong 2 giai đoạn, gây ra tổng sát thương phép thuật là 90%, mỗi lần tấn công có 45% cơ hội thêm [Minh Thần Môn: Dịch Thương] nếu mục tiêu ở trạng thái [Minh Thần Môn: Dịch Thương] khi tấn công. 50% cơ hội thêm [sát thương phép thuật tăng 10%] trong 2 lượt", "初始激活", "升级条件：英雄到达<div fontcolor=45a536>6星</div>自动升级", "24611", 0, 1, 1, {{20902,21602}}, 0, 1, 0, 0}]],
