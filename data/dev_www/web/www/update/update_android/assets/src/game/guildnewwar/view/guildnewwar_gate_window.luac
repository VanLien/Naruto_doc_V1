function GuildnewwarGateWindow:update8Rank(list)
    if not self.top_rank_list then
        return 
    end
    local rank8_list = list or {} -- model:getMatchData8(self.select_zone_id) 
    for i, v in ipairs(self.top_rank_list) do
        local data = rank8_list[i]
        if data then 
            local badge_data = GuildController:getInstance():getModel():getBadgeItemData(data.avatar, data.avatar_frame)
            badge_data.lev = data.lev
            v.node_badge.badge_item:setData(badge_data)
            v.node_badge.data = data
            v.label_guild_name:setString(data.name)
            v.label_guild_power:setString(data.power)
            v.sp_empty:setVisible(false)
            v.node_badge:setVisible(true)
        else
            v.sp_empty:setVisible(true)
            v.node_badge:setVisible(false)
            v.label_guild_name:setString(TI18N("语言_c_1891"))
            v.label_guild_power:setString(0)
        end
    end
end

--刷新赛季信息 排名 赛程  时间  条件
function GuildnewwarGateWindow:updateSeasonInfo()
    local str_kind = {
        [1] = {
            match_title = TI18N("语言_c_551"),
            time_title = TI18N("语言_c_5261"),
            condition_title = TI18N("语言_c_5263"),
            match_str = TI18N("语言_c_5259"),
            time_str = TI18N("03.29-0.4.23(距离常规赛结束剩余16天2小时)"),
            condition_str = TI18N("语言_c_5249"),
        },
        [2] = {   
            match_title = TI18N("语言_c_551"),
            time_title = TI18N("语言_c_5261"),
            condition_title = TI18N("语言_c_5262"), 
            match_str = TI18N("传奇赛未开启"),
            time_str = TI18N("03.29-0.4.23(距离下次开启16天2小时)"),
            condition_str = TI18N("语言_c_5395"),
        }
    }
    if self.match_type == GuildNewwarConst.BattleType.nomal then
        local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
        if not season_data then
            self.image_title_bg.label_title:setString(TI18N("--"))
            self.match_key:setString(str_kind[self.match_type].match_title)
            self.match_value:setString("--")
            self.time_key:setString(str_kind[self.match_type].time_title)
            self.time_value:setString("--")
            self.condition_key:setString(str_kind[self.match_type].condition_title)
            self.condition_value:setString("--")
            self:adaptLabelValue()
            return 
        end
        self.image_title_bg.label_title:setString(TI18N("语言_c_5258")..season_data.zone_rank)
        self.match_key:setString(str_kind[self.match_type].match_title)
        self.time_key:setString(str_kind[self.match_type].time_title)
        self.condition_key:setString(str_kind[self.match_type].condition_title)

        season_data.season_start_time = season_data.season_start_time == 0 and GameNet:getInstance():getTime() or season_data.season_start_time
        season_data.season_end_time = season_data.season_end_time == 0 and GameNet:getInstance():getTime() or season_data.season_end_time
        local nowtime = GameNet:getInstance():getTime()
        local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
        local is_open = season_data.season_end_time > nowtime and season_data.season_start_time < nowtime

        local y = TimeTool.xsdate("%Y",season_data.season_start_time,timezone)
        local m = TimeTool.xsdate("%m",season_data.season_start_time,timezone)
        local d = TimeTool.xsdate("%d",season_data.season_start_time,timezone)
        local start_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        local y = TimeTool.xsdate("%Y",season_data.season_end_time,timezone)
        local m = TimeTool.xsdate("%m",season_data.season_end_time,timezone)
        local d = TimeTool.xsdate("%d",season_data.season_end_time,timezone)
        local end_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        if is_open then
            self.match_value:setString(TI18N("语言_c_5259"))
            local dis_time = season_data.season_end_time - nowtime
            local y = os.date("%Y", dis_time)--TimeTool.xsdate("%Y",season_data.season_end_time,timezone)
            local m = os.date("%m", dis_time)--TimeTool.xsdate("%m",season_data.season_end_time,timezone)
            local d = os.date("%d", dis_time)--TimeTool.xsdate("%d",season_data.season_end_time,timezone)
            -- local other_time_str = string.format(TI18N("(语言_c_5366)"),m,d)
            -- self.time_value:setString(start_str.." - "..end_str..other_time_str)
            self:refreshSurplusTime(  )
        else
            self.match_value:setString(TI18N("语言_c_5260"))
            local dis_time = season_data.season_start_time - nowtime
            local y = os.date("%Y", dis_time)--TimeTool.xsdate("%Y",season_data.season_end_time,timezone)
            local m = os.date("%m", dis_time)--TimeTool.xsdate("%m",season_data.season_end_time,timezone)
            local d = os.date("%d", dis_time)--TimeTool.xsdate("%d",season_data.season_end_time,timezone)
            local other_time_str = ""--string.format(TI18N("(距离下次开启剩余%s天%s小时)"),m,d)
            self.time_value:setString(start_str.."-"..end_str..other_time_str)
            self:openGuildWarSurplusTimer(false)
        end
        self.condition_value:setString(str_kind[self.match_type].condition_str)
    else
        local main_data = model:getMainData()
        if not main_data then
            self.image_title_bg.label_title:setString(TI18N("--"))
            self.match_key:setString(str_kind[self.match_type].match_title)
            self.match_value:setString("--")
            self.time_key:setString(str_kind[self.match_type].time_title)
            self.time_value:setString("--")
            self.condition_key:setString(str_kind[self.match_type].condition_title)
            self.condition_value:setString("--")
            self:adaptLabelValue()
            return
        end
        local nowtime = GameNet:getInstance():getTime()
        local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
        local is_open = main_data.start_time < nowtime and main_data.end_time > nowtime

        local y = TimeTool.xsdate("%Y",main_data.start_time,timezone)
        local m = TimeTool.xsdate("%m",main_data.start_time,timezone)
        local d = TimeTool.xsdate("%d",main_data.start_time,timezone)
        local start_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        local y = TimeTool.xsdate("%Y",main_data.end_time,timezone)
        local m = TimeTool.xsdate("%m",main_data.end_time,timezone)
        local d = TimeTool.xsdate("%d",main_data.end_time,timezone)
        local end_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        if is_open then
            local str, str1 = model:getMacthText(main_data.step, main_data.step_status)
            local match_str = str or ""
            if str1 then
                match_str = match_str.." "..str1--string_format("<div fontcolor=#f1e2c7 outline=2,#5c2705>%s</div>", match_str) .. string_format("<div fontcolor=#52f559>%s</div>", str1)
            end
            self.match_value:setString(match_str)
            -- self.match_value:setString(TI18N("语言_c_5396"))
            local dis_time = main_data.end_time - nowtime
            local y = os.date("%Y", dis_time)
            local m = os.date("%m", dis_time)
            local d = os.date("%d", dis_time)
            -- local other_time_str = string.format(TI18N("(语言_c_5366)"),m,d)
            -- self.time_value:setString(start_str.." - "..end_str..other_time_str)
            if main_data.is_open == 2 then --公会数据量不足
                self.match_value:setString(TI18N("语言_c_5354"))--(str_kind[self.match_type].time_title..TI18N("（组织数量不足64，未开赛）"))
            end
            self:refreshSurplusTime()
        else
            self.match_value:setString(TI18N("语言_c_5397"))
            local dis_time = main_data.start_time - nowtime
            local y = os.date("%Y", dis_time)
            local m = os.date("%m", dis_time)
            local d = os.date("%d", dis_time)
            local other_time_str = ""--string.format(TI18N("(距离下次开启剩余%s天%s小时)"),m,d)
            self.time_value:setString(start_str.."-"..end_str..other_time_str)
            self:openGuildWarSurplusTimer(false)
        end
        self.condition_key:setString(str_kind[self.match_type].condition_title)
        self.condition_value:setString(str_kind[self.match_type].condition_str)
    end
    self:adaptLabelValue()
    self:updateCurSeason()
end

function GuildnewwarGateWindow:adaptLabelValue()
    local pos_x = self.match_key:getPositionX() + self.match_key:getContentSize().width + 20
    pos_x = math.max(pos_x, self.time_key:getPositionX() + self.time_key:getContentSize().width + 20)
    pos_x = math.max(pos_x, self.condition_key:getPositionX() + self.condition_key:getContentSize().width + 20)
    local max_width = 720 - pos_x - 6
    self.match_value:setMaxWidth(max_width, false)
    self.time_value:setMaxWidth(max_width, false)
    self.condition_value:setMaxWidth(max_width, false)
    local str = self.condition_value:getString()
    self.condition_value:setString("")
    self.condition_value:setString(str)
    local str = self.time_value:getString()
    self.time_value:setString("")
    self.time_value:setString(str)
    local str = self.match_value:getString()
    self.match_value:setString("")
    self.match_value:setString(str)
    self.match_value:setPositionX(pos_x)
    self.time_value:setPositionX(pos_x)
    self.condition_value:setPositionX(pos_x)
end

function GuildnewwarGateWindow:getGuildWarSurplusTime()
    if self.match_type == GuildNewwarConst.BattleType.nomal then
        local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
        if not season_data then
            return 0
        end
        local nowtime = GameNet:getInstance():getTime()
        local is_open = season_data.season_end_time > nowtime and season_data.season_start_time < nowtime
        return season_data.season_end_time - nowtime
    else
        local main_data = model:getMainData()
        if not main_data then
            return 0
        end
        local nowtime = GameNet:getInstance():getTime()
        local is_open = main_data.start_time > nowtime and main_data.end_time < nowtime
        return main_data.end_time - nowtime
    end
end

function GuildnewwarGateWindow:getTargetTimeStr()
    local timezone = InviteCodeController:getInstance():getModel():getServerTimeZone()--服务器时区
    if self.match_type == GuildNewwarConst.BattleType.nomal then
        local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
        if not season_data then
            return ""
        end
        local y = TimeTool.xsdate("%Y",season_data.season_start_time,timezone)
        local m = TimeTool.xsdate("%m",season_data.season_start_time,timezone)
        local d = TimeTool.xsdate("%d",season_data.season_start_time,timezone)
        local start_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        local y = TimeTool.xsdate("%Y",season_data.season_end_time,timezone)
        local m = TimeTool.xsdate("%m",season_data.season_end_time,timezone)
        local d = TimeTool.xsdate("%d",season_data.season_end_time,timezone)
        local end_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        return start_str.."-"..end_str
    else
        local main_data = model:getMainData()
        if not main_data then
            return ""
        end
        local y = TimeTool.xsdate("%Y",main_data.start_time,timezone)
        local m = TimeTool.xsdate("%m",main_data.start_time,timezone)
        local d = TimeTool.xsdate("%d",main_data.start_time,timezone)
        local start_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        local y = TimeTool.xsdate("%Y",main_data.end_time,timezone)
        local m = TimeTool.xsdate("%m",main_data.end_time,timezone)
        local d = TimeTool.xsdate("%d",main_data.end_time,timezone)
        local end_str = y.."."..m.."."..d--string.format(TI18N("语言_c_4763"),y,m,d)
        return start_str.."-"..end_str
    end
end

-- 剩余时间显示
function GuildnewwarGateWindow:refreshSurplusTime(  )
	self.surplusTime = self:getGuildWarSurplusTime()
    if self.surplusTime < 0 then
        self.surplusTime = 0
    end
    local str = self:getTargetTimeStr()
	self.time_value:setString(str.."("..string.format(TI18N("语言_c_536"), TimeTool.GetTimeFormatDay2(self.surplusTime))..")")
	self:openGuildWarSurplusTimer(true)
end

-- 活动剩余时间倒计时
function GuildnewwarGateWindow:openGuildWarSurplusTimer( status )
	if status == true then
		if self.guildwar_timer == nil then
            self.guildwar_timer = GlobalTimeTicket:getInstance():add(function()
                self.surplusTime = self.surplusTime - 1
                if self.surplusTime >= 0 then
                    local str = self:getTargetTimeStr()
                    self.time_value:setString(str.."("..string.format(TI18N("语言_c_536"), TimeTool.GetTimeFormatDay2(self.surplusTime))..")")
                else
                	self.surplusTime = 0
                	GlobalTimeTicket:getInstance():remove(self.guildwar_timer)
            		self.guildwar_timer = nil
                end
            end, 1)
        end
	else
		if self.guildwar_timer ~= nil then
            GlobalTimeTicket:getInstance():remove(self.guildwar_timer)
            self.guildwar_timer = nil
        end
	end
end

function GuildnewwarGateWindow:updateCurSeason(t_season_data)
    local season_data = t_season_data or GuildNewwarController:getInstance():getModel():getSeasonData()
    if season_data then
        if self.select_zone_id ~= season_data.zone_id then
            self.select_zone_id = season_data.zone_id
            if t_season_data then
                self:updateKingInfo()
            end
        end
        select_zone_id = season_data.zone_id
        self.label_division_title:setString(string_format(TI18N("语言_c_558"), season_data.zone_id))
    end
end

--@percent 百分比
--@label 进度条中间文字描述
--@is_blue 是否 ture:蓝条
function GuildnewwarGateWindow:showProgressbar()
end

function GuildnewwarGateWindow:close_callback(  )
    self:openGuildWarSurplusTimer(false)
    if self.item_load_bg then
        self.item_load_bg:DeleteMe()
    end
    self.item_load_bg = nil

    if self.item_list then
        for i,v in ipairs(self.item_list) do
            v:DeleteMe()
        end
    end
    for i, v in ipairs(self.top_rank_list) do
        if v.node_badge and v.node_badge.badge_item then
            v.node_badge.badge_item:DeleteMe()
        end
    end
    self.top_rank_list = nil

    if self.update_red_status_event ~= nil then
        GlobalEvent:getInstance():UnBind(self.update_red_status_event)
        self.update_red_status_event = nil
    end

    controller:openGuildnewwarGateWindow(false)
end

-------------------------------------- item -----------------------------
GuildnewwarDivisionItem = class("GuildnewwarDivisionItem", function()
    return ccui.Widget:create()
end)

function GuildnewwarDivisionItem:ctor()
	self:configUI()
	self:register_event()
end

function GuildnewwarDivisionItem:configUI( )
	self:setTouchEnabled(false)
	self:setAnchorPoint(cc.p(0, 0))

	local csbPath = PathTool.getTargetCSB("guildnewwar/guildnewwar_division_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self:addChild(self.root_wnd)
    self:setCascadeOpacityEnabled(true)
	self.size = self.root_wnd:getContentSize()
    self:setContentSize(self.size)
    self:setTouchEnabled(true)
    
    self.container = self.root_wnd:getChildByName("container")
    self.image_mark = self.container:getChildByName("image_mark")
    self.label_title = self.container:getChildByName("label_title")
    self.panel_select = self.container:getChildByName("panel_select")
end

function GuildnewwarDivisionItem:register_event(  )
    self:setTouchEnabled(true)
    registerButtonEventListener(self, handler(self, self.onClickItem), false, 2)
end

function GuildnewwarDivisionItem:onClickItem()
    GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_SELECT_DIVISION, self.data, nil, nil, nil, nil, nil, true)
end

function GuildnewwarDivisionItem:setData(data)
    self.data = data
    local select_srv = select_zone_id
    local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
    self.image_mark:setVisible(season_data.zone_id == data.zone_id)
    self.panel_select:setVisible(select_srv == data.zone_id)
    self.label_title:setString(string_format(TI18N("语言_c_558"), data.zone_id))
end

function GuildnewwarDivisionItem:getData()
    return self.data
end

function GuildnewwarDivisionItem:DeleteMe(  )
	self:removeAllChildren()
    self:removeFromParent()
end