    self.panel_elite = self.container:getChildByName("panel_elite")
    self.panel_elite:setVisible(false)

    self.rankingreward_btn = self.panel_elite:getChildByName("rankingreward_btn")
    self.rankingreward_btn:getChildByName("label"):setChangeScaleOffWidth(-1000)
    self.rankingreward_btn:getChildByName("label"):setString(TI18N("语言_c_264"))
    setTextMaxWidth(self.rankingreward_btn:getChildByName("label"), 100, -8)
    -- self.rankingreward_btn:getChildByName("label"):setString(transformTextToShort(TI18N("语言_c_264"),8))
	-- addEvt2showAllTextTips(self.rankingreward_btn:getChildByName("label"),TI18N("语言_c_264"),8)
    self.rank_list_btn = self.panel_elite:getChildByName("rank_list_btn")
    self.rank_list_btn:getChildByName("label"):setChangeScaleOffWidth(-1000)
    self.rank_list_btn:getChildByName("label"):setString(TI18N("语言_c_271"))
    setTextMaxWidth(self.rank_list_btn:getChildByName("label"), 100, -8)
    -- self.rank_list_btn:getChildByName("label"):setString(transformTextToShort(TI18N("语言_c_271"),8))
	-- addEvt2showAllTextTips(self.rank_list_btn:getChildByName("label"),TI18N("语言_c_271"),8)
    self.plan_btn = self.panel_elite:getChildByName("plan_btn")
    self.plan_btn:getChildByName("label"):setChangeScaleOffWidth(-1000)
    self.plan_btn:getChildByName("label"):setString(TI18N("语言_c_5255"))
    setTextMaxWidth(self.plan_btn:getChildByName("label"), 100, -8)
    -- self.plan_btn:getChildByName("label"):setString(transformTextToShort(TI18N("语言_c_5255"),8))
	-- addEvt2showAllTextTips(self.plan_btn:getChildByName("label"),TI18N("语言_c_5255"),8)
    self.luckydraw_btn = self.panel_elite:getChildByName("luckydraw_btn")
    self.luckydraw_btn:getChildByName("label"):setChangeScaleOffWidth(-1000)
    self.luckydraw_btn:getChildByName("label"):setString(TI18N("语言_c_5256"))
    setTextMaxWidth(self.luckydraw_btn:getChildByName("label"), 100, -8)
    -- self.luckydraw_btn:getChildByName("label"):setString(transformTextToShort(TI18N("语言_c_5256"),8))
	-- addEvt2showAllTextTips(self.luckydraw_btn:getChildByName("label"),TI18N("语言_c_5256"),8)
    self.elitematch_btn = self.panel_elite:getChildByName("elitematch_btn")
    self.elitematch_btn:getChildByName("label"):setString(TI18N("语言_c_550"))
    self.form_btn = self.panel_elite:getChildByName("form_btn")
    self.form_btn:getChildByName("label"):setString(TI18N("语言_c_5257"))

    self.top_rank_list = {}
    for i=1,8 do
        local object = {}
        local node_badge = self.panel_elite:getChildByName("node_badge_"..i)
        local badge_item = GuildBadgeItem.new()
        node_badge:addChild(badge_item)
        node_badge.badge_item = badge_item
        object.node_badge = node_badge
        badge_item:setClickCallBack(function(data)
            if node_badge.data then
                GuildController:getInstance():send13509(node_badge.data.gid, node_badge.data.srv_id)
            end
        end)
        object.label_guild_name = self.panel_elite:getChildByName("label_guild_name_"..i)
        object.label_guild_power = self.panel_elite:getChildByName("label_guild_power_"..i)
        object.sp_empty = self.panel_elite:getChildByName("sp_empty_"..i)
        self.top_rank_list[i] = object
    end

    self:adaptationScreen()
end

--段位iconspine
function GuildnewwarGateWindow:playLevelSpine(status, config)
    if status == false then
        if self.level_spine then
            self.level_spine:clearTracks()
            self.level_spine:removeFromParent()
            self.level_spine = nil
        end
    else
        if not config then return end
        if self.level_spine_record == nil or self.level_spine_record ~= config.ico then
            self.level_spine_record = config.ico
            self:playLevelSpine(false)
            self.level_spine = createEffectSpine(config.ico, cc.p(0, 0), cc.p(0.5, 0.5), true, PlayerAction.action)
            -- self.level_spine = createEffectSpine("E24177", cc.p(0, 0), cc.p(0.5, 0.5), true, PlayerAction.action)
            self.panel_info.node_rank:addChild(self.level_spine, 1)
        end
    end
end

--设置适配屏幕
function GuildnewwarGateWindow:adaptationScreen()
    --对应主窗口.四面对应xy位置 ..相对位置是self.main_container左下角(0,0)
    local top_y = display.getTop(self.container)
    local bottom_y = display.getBottom(self.container)
    local left_x = display.getLeft(self.container)
    local right_x = display.getRight(self.container)

    local tab_y = self.panel_title:getPositionY()
    self.panel_title:setPositionY(top_y - (self.container_size.height - tab_y))

    local tab_y = self.tab_container:getPositionY()
    self.tab_container:setPositionY(top_y - (self.container_size.height - tab_y))

    local close_btn_y = self.close_btn:getPositionY()
    self.close_btn:setPositionY(bottom_y + close_btn_y)
end


function GuildnewwarGateWindow:register_event(  )
    registerButtonEventListener(self.close_btn, handler(self, self.onClickCloseBtn), true, 2)

    registerButtonEventListener(self.image_right, handler(self, self.onClickLookDivisionBtn), true, 2)

    registerButtonEventListener(self.rank_btn, handler(self, self.onClickRankBtn), true, 2)
    registerButtonEventListener(self.elite_btn, handler(self, self.onClickEliteBtn), true, 2)
    registerButtonEventListener(self.award_box_btn, handler(self, self.onClickAwardBoxBtn), true, 2)
    registerButtonEventListener(self.match_btn, handler(self, self.onClickMatchBtn), true, 2)
    registerButtonEventListener(self.rule_btn, handler(self, self.onClickRuleBtn), true, 2)
    registerButtonEventListener(self.panel_info.btn_message, handler(self, self.onClickMessageBtn), true, 2)

    registerButtonEventListener(self.panel_touch, function()
        self.panel_touch:setVisible(false)
        self:shrinkInfoContainer()
    end, true)

    --精英
    registerButtonEventListener(self.rankingreward_btn, handler(self, self.onClickRankingAwardBtn), true, 2)
    registerButtonEventListener(self.rank_list_btn, handler(self, self.onClickRankListBtn), true, 2)
    registerButtonEventListener(self.plan_btn, handler(self, self.onClickPlanBtn), true, 2)
    registerButtonEventListener(self.luckydraw_btn, handler(self, self.onClickLuckyDrawBtn), true, 2)
    registerButtonEventListener(self.elitematch_btn, handler(self, self.onClickElitematch), true, 2)
    registerButtonEventListener(self.form_btn, handler(self, self.onClickFormBtn), true, REGISTER_BUTTON_SOUND_BUTTON_TYPY)


    for k, object in pairs(self.tab_list) do
        if object.tab_btn then
            object.tab_btn:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playTabButtonSound()
                    self:changeSelectedTab(object.index)
                end
            end)
        end
    end

    -- 红点更新
    if self.update_red_status_event == nil then
        self.update_red_status_event = GlobalEvent:getInstance():Bind(GuildNewwarEvent.UpdateGuildWarRedStatusEvent, function(redtype, status)
            self:updateMainRedStatus(redtype, status)
        end)
    end

    
    self:addGlobalEvent(GuildNewwarEvent.GUILDNEWWAR_SELECT_DIVISION, function(data)
        --确认选择的赛区
        self:updateCurSeason(data)
        self:shrinkInfoContainer()
    end)
    --联盟战状态 赛季数据更新
    self:addGlobalEvent(GuildNewwarEvent.UpdateGuildWarStatusEvent, function(data)
        self:updateNormalInfo()
        self:updateSeasonInfo()
    end)
    --精英赛 信息
    self:addGlobalEvent(GuildNewwarEvent.GUILDNEWWAR_MAIN_EVENT, function(data)
        if self.match_type == GuildNewwarConst.BattleType.elite then
            self:updateSeasonInfo()
        end
    end)

    --8强
    self:addGlobalEvent(GuildNewwarEvent.GUILDNEWWAR_UPDATE_Main_Rank, function(data)
        self:update8Rank(data)
    end)

    self:addGlobalEvent(GuildNewwarEvent.GUILDNEWWAR_ALL_RED_POINT_EVENT, function(data)
        self:updateLegendMarkRedStatus()
        self:updateLegendMyMatchRedStatus()
        self:updateLegendGoMatchRedStatus()
    end)

    self:addGlobalEvent(BackpackEvent.ADD_GOODS, function(bag_code,temp_list)
        self:updateTurnTableRed(temp_list)
    end)
    self:addGlobalEvent(BackpackEvent.DELETE_GOODS, function(bag_code,temp_list)
        self:updateTurnTableRed(temp_list)
    end)
    self:addGlobalEvent(BackpackEvent.MODIFY_GOODS_NUM, function(bag_code,temp_list)
        self:updateTurnTableRed(temp_list)
    end)
    
end

--常规赛红点
function GuildnewwarGateWindow:updateMainRedStatus( redtype, status )
    local box_btn_status = model:checkRedIsShowByRedType(GuildConst.red_index.guildnewwar_box)
    addRedPointToNodeByStatus(self.award_box_btn, box_btn_status, -5, -5)
    box_btn_status = box_btn_status or model:checkRedIsShowByRedType(GuildConst.red_index.guildnewwar_match)
    box_btn_status = box_btn_status or model:checkRedIsShowByRedType(GuildConst.red_index.guildnewwar_count)
    addRedPointToNodeByStatus(self.tab_list[1].tab_btn, box_btn_status, -135, -5)
    addRedPointToNodeByStatus(self.match_btn, box_btn_status, 0, 1.9)
end

--精英赛 页签红点
function GuildnewwarGateWindow:updateLegendMarkRedStatus()
    local box_btn_status = model:checkPeakChampionTotalRedPoint()
    addRedPointToNodeByStatus(self.tab_list[2].tab_btn, box_btn_status, -5, -5)
end
--赛程安排red
function GuildnewwarGateWindow:updateLegendMyMatchRedStatus()
    local box_btn_status = model:getMyMatchRedPoint()
    addRedPointToNodeByStatus(self.plan_btn, box_btn_status)
end
--进入大赛red
function GuildnewwarGateWindow:updateLegendGoMatchRedStatus()
    local box_btn_status = model:getMatchStageRedPoint()
    addRedPointToNodeByStatus(self.elitematch_btn, box_btn_status)
end

--抽奖
function GuildnewwarGateWindow:updateTurnTableRed()
    local box_btn_status = model:checkLegendTurnTable()
    addRedPointToNodeByStatus(self.luckydraw_btn, box_btn_status)
end

function GuildnewwarGateWindow:onClickLookDivisionBtn()
    self:shrinkInfoContainer()
end

-- 关闭
function GuildnewwarGateWindow:onClickCloseBtn(  )
    controller:openGuildnewwarGateWindow(false)
end
--------------常规赛
-- 打开规则说明
function GuildnewwarGateWindow:onClickRuleBtn(  )
    if self.match_type == GuildNewwarConst.BattleType.elite then
        MainuiController:getInstance():openCommonExplainView(true, Config.GuildSagaChampionData.data_explain)
    else
        MainuiController:getInstance():openCommonExplainView(true, Config.GuildWarNewData.data_explain)
    end
end
-- 打开赛季统计
function GuildnewwarGateWindow:onClickMessageBtn(  )
    controller:openGuildnewwarSeasonStatisticsPanel(true)
end
-- 打开段位排行榜
function GuildnewwarGateWindow:onClickRankBtn(  )
    controller:openGuildnewwarSeasonRankWindow(true, {zone_id = self.select_zone_id})
end
-- 打开段位奖励
function GuildnewwarGateWindow:onClickEliteBtn(  )
    controller:openGuildNewWarRankAwardPreview(true)
end
-- 打开战果宝箱
function GuildnewwarGateWindow:onClickAwardBoxBtn(  )
    controller:openAwardBoxWindow(true)
end
-- 打开常规赛开战
function GuildnewwarGateWindow:onClickMatchBtn(  )
    MainuiController:getInstance():requestOpenBattleRelevanceWindow(BattleConst.Fight_Type.GuildNewWar)
end
