-- 打开赛程安排
function GuildnewwarGateWindow:onClickPlanBtn(  )
    local main_data = model:getMainData()
    if not main_data then return end
    if model.my_match_redpoint then
        controller:sender27731(1)
        model:setMyMatchRedPoint(false)
    end
    controller:openGuildnewwarElitePlanPanel(true)
end
-- 打开幸运抽奖
function GuildnewwarGateWindow:onClickLuckyDrawBtn(  )
    controller:openGuildnewwarTurntablePanel(true)
end
-- 打开传奇赛
function GuildnewwarGateWindow:onClickElitematch(  )
    controller:openGuildnewwarEliteGuessingWindow(true)
end
-- 布阵
function GuildnewwarGateWindow:onClickFormBtn(  )
    controller:openGuildnewwarEliteTeamListPanel(true)
end

--==============================--
--desc:收缩赛区面板
--@return 
--==============================--
function GuildnewwarGateWindow:shrinkInfoContainer()
	if not self.panel_division then
		return
	end
    if self.is_in_shrink == true then return end
    self.is_in_shrink = true

    self.is_shrink = not self.is_shrink
    self.image_right:setFlippedY(self.is_shrink)
    self.panel_division:setVisible(true)

    local len = 587.5
    local move_by_1 = nil
    local fade_1 = nil
    local scaleY = 1
    local posx = self.panel_division:getPositionX()
    if self.is_shrink == true then
        move_by_1 = cc.MoveTo:create(0.6, cc.p(posx, 300))
		fade_1 = cc.FadeOut:create(0.6)
    else
        move_by_1 = cc.MoveTo:create(0.6, cc.p(posx, 90))
		fade_1 = cc.FadeIn:create(0.1)
		scaleY = -1
	end

    local call_fun_1 = cc.CallFunc:create(function()
        self.is_in_shrink = false
        if self.is_shrink == true then
            self.panel_division:setVisible(false)
        end
        self.panel_touch:setVisible(not self.is_shrink)
	end)
	local ease_out = cc.EaseBackOut:create(move_by_1)

    self.panel_division:runAction(cc.Sequence:create(cc.Spawn:create(ease_out, fade_1), call_fun_1)) 
    if not self.is_shrink then
        local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
        local list = {}
        if season_data then
            for i=1,season_data.max_zone_id do
                list[#list + 1] = {zone_id = i}
            end
        end
        self.division_scrollview:setData(list)
    end
end

--------------精英赛

-- 切换标签页
function GuildnewwarGateWindow:changeSelectedTab(index, not_check)
    if not not_check and self.tab_object ~= nil and self.tab_object.index == index then return end
    -- if index == ElitematchConst.MatchType.eKingMatch then
    --     message("敬请期待")
    --     return
    -- end
    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        -- self.tab_object.label:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
        self.tab_object = nil
    end
    self.match_type = index
    self.tab_object = self.tab_list[index]
    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        -- self.tab_object.label:setTextColor(cc.c4b(0xff, 0xed, 0xd6, 0xff))
    end
    if index == ElitematchConst.MatchType.eNormalMatch then --常规赛
        self:setBackgroundImg("elitetournamen_10020")
        self.panel_common:setVisible(true)
        self.panel_elite:setVisible(false)
        self:updateNormalInfo()
    elseif index == ElitematchConst.MatchType.eKingMatch then --王者赛
        self:setBackgroundImg("elitetournamen_10021")
        self.panel_common:setVisible(false)
        self.panel_elite:setVisible(true)
        self:updateKingInfo()
    end
    self:updateSeasonInfo()
end

function GuildnewwarGateWindow:setBackgroundImg(bg_name)
    -- local bg_res = PathTool.getPlistImgForDownLoad("bigbg/elitematch", bg_name, true)
    -- if self.record_bg_res ~= bg_res then
    --     self.record_bg_res = bg_res
    --     self.item_load_bg = loadImageTextureFromCDN(self.background, bg_res, ResourcesType.single, self.item_load_bg) 
    -- end
    self.background:loadTexture(bg_name..".png", ResourcesType.plist)
end

function GuildnewwarGateWindow:openRootWnd( setting )
    local setting = setting or {}
    self.match_type = setting.g_type or GuildNewwarConst.BattleType.nomal
    self:setData()
    self:updateMainRedStatus()

    -- 拉取精英賽
    local main_data = model:getMainData()
    self:updateLegendMarkRedStatus()
    self:updateLegendMyMatchRedStatus()
    self:updateLegendGoMatchRedStatus()
    self:updateTurnTableRed()

    controller:sender14240()
    controller:sender14241() --个人信息
    -- controller:sender27714(0,1,8)
end

function GuildnewwarGateWindow:setData()
    self:changeSelectedTab(self.match_type or 1, true)
end

function GuildnewwarGateWindow:updateTimeInfo()
    if not self.scdata then return end


    local config = Config.ArenaEliteData.data_zone_fun(self.scdata.zone_id)

    local zone_name = ""
    if config then 
        zone_name = string_format(TI18N("语言_c_3877"), config.name)
    end

    local server_time = GameNet:getInstance():getTime()
    local start_time = TimeTool.getMD2(self.scdata.start_time)
    local end_time = TimeTool.getMD2(self.scdata.end_time- 10)
    self.match_time:setString(string_format(TI18N("语言_c_3878"), self.scdata.period, zone_name, start_time, end_time))
    
    if self.scdata.state == 1 then
        self.match_time_str1 = TI18N("语言_c_3879")
        self.match_time_str2 = TI18N("语言_c_3880")
    elseif self.scdata.state == 2 then
        self.match_time_str1 = TI18N("语言_c_3881")
        self.match_time_str2 = TI18N("语言_c_3882")
    elseif self.scdata.state == 3 then
        self.match_time_str1 = TI18N("语言_c_3883")
        self.match_time_str2 = TI18N("语言_c_3884")
    else
        return
    end
    self:setLessTime(self.scdata.state_time)
end

--更新常规赛
function GuildnewwarGateWindow:updateNormalInfo()
    local guild_info = GuildController:getInstance():getModel():getMyGuildInfo()
    local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
    if not season_data then return end
    local guild_name = guild_info and guild_info.name or "--"
    self.panel_info.label_name_val:setString(guild_name)
    self.panel_info.label_cups_val:setString(season_data.cups or 0)
    self.panel_info.label_devote_val:setString(season_data.name or "--")
    if season_data.all == 0 then
        self.panel_info.label_win_rate_val:setString("0%")
    else
        self.panel_info.label_win_rate_val:setString(math.floor(season_data.win/season_data.all*100 + 0.5).."%" or "--")
    end
    self.panel_info.label_win_streak_val:setString(season_data.win_streak)

    local level = season_data.dan
    local config = Config.GuildWarNewData.data_guild_war_level[level]
    if config then
        self:playLevelSpine(true, config)
        local bg_res = PathTool.getPlistImgForDownLoad("elitematch/elitematch_icon",config.name_ico, false)
        if self.record_txt_res ~= bg_res then
            self.record_txt_res = bg_res
            self.item_load1 = loadSpriteTextureFromCDN(self.panel_info.level_txt_icon, bg_res, ResourcesType.single, self.item_load1) 
        end
    end
    local next_config = Config.GuildWarNewData.data_guild_war_level[level + 1]
    if next_config then
        self.panel_progress.current_tips:setString(string_format(TI18N("语言_c_5364"),next_config.name))
        local percent = (season_data.cups - config.base_exp)/config.need_exp*100
        self.panel_progress.progress_bar:setPercent(math.min(percent, 100))
        self.panel_progress.label_progress:setString((season_data.cups - config.base_exp).."/"..config.need_exp)
    else
        --最高段位
        next_config = {}
        self.panel_progress.current_tips:setString(string_format("<div fontcolor=#ffffff outline=2,#000000>%s</div>",TI18N("语言_c_5365")))
        local percent = 100
        self.panel_progress.progress_bar:setPercent(math.min(percent, 100))
        self.panel_progress.label_progress:setString(TI18N("语言_c_5383"))
    end

    --奖励数据
    local lev_award= next_config.lev_award or {}
    local setting = {}
    setting.scale = 0.8
    setting.max_count = 4
    setting.is_center = true
    self.item_list = commonShowSingleRowItemList(self.panel_progress.item_scrollview, self.item_list, lev_award, setting)
end

