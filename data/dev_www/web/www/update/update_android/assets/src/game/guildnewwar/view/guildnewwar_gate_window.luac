GuildnewwarGateWindow = GuildnewwarGateWindow or BaseClass(BaseView)

local controller = GuildNewwarController:getInstance()
local model = controller:getModel()
local string_format = string.format
local table_sort = table.sort
local select_zone_id = 0
local GateType = {
    [1] = {name = TI18N("语言_c_3889")},
    [2] = {name = TI18N("语言_c_5251")}
}

function GuildnewwarGateWindow:__init()
    self.win_type = WinType.Full
    self.is_full_screen = true
    self.res_list = {
        {path = PathTool.getPlistImgForDownLoad("elitetournamen", "elitetournamen"), type = ResourcesType.plist},
        {path = PathTool.getPlistImgForDownLoad("guildwar", "guildwar"), type = ResourcesType.plist},
    }
    self.layout_name = "guildnewwar/guildnewwar_gate_window"

    self.tab_list = {}
    self.is_shrink = true --赛区是否显示
    self.is_in_shrink = false --赛区收缩状态
    self.select_zone_id = 1
end

function GuildnewwarGateWindow:open_callback(  )
