function GuildNewwarController:printMsgGuildNewwar(id, msg)
end

-- 联盟战数据
function GuildNewwarController:handle14200( data )
    self:printMsgGuildNewwar(14200, data)
    data = data or {}
    if data.count then -- 已挑战次数
        self.model:setGuildWarChallengeCount(data.count)
    end
    if data.result then
        self.model:setGuildWarResult(data.result)
    end
    if data.ranks then
        self.model:setGuildWarTopThreeRank(data.ranks)
    end

    -- 我方联盟基础信息
    local myBaseInfo = {}
    myBaseInfo.gname = data.gname1
    myBaseInfo.hp = data.hp1
    myBaseInfo.buff_lev = data.buff_lev1
    --new dan 段位  cups 杯数
    myBaseInfo.dan = data.dan or 1
    myBaseInfo.cups = data.cups or 1000
    self.model:setMyGuildWarBaseInfo(myBaseInfo)

    -- 敌方联盟数据
    self.model:setEnemyGuildWarData(data)

    GlobalEvent:getInstance():Fire(GuildNewwarEvent.GuildWarEnemyPositionDataInitEvent)
end
 
-- 敌方单个据点数据
function GuildNewwarController:handle14201( data )
    self:printMsgGuildNewwar(14201, data)
    if data and self.attk_position_window then
        self.attk_position_window:setData(data)
    end
end

-- 发起战斗
function GuildNewwarController:handle14202( data )
    self:printMsgGuildNewwar(14202, data)
    message(data.msg)
    if data.code == TRUE then
        self.model:setGuildWarChallengeCount(data.count)
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.UpdateGuildwarChallengeCountEvent)
        self:openAttkPositionWindow(false)
        self:openAttkLookWindow(false)
    end
end

-- 挑战据点的战斗结果
function GuildNewwarController:handle14203( data )
    self:printMsgGuildNewwar(14203, data)
    BattleController:getInstance():openFinishView(true, BattleConst.Fight_Type.GuildNewWar, data)
end

-- 联盟战状态
function GuildNewwarController:handle14204( data )
    self:printMsgGuildNewwar(14204, data)
    if data then
        self.model:setGuildWarStatus(data)
        self.model:setSeasonData(data)
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.UpdateGuildWarStatusEvent, data.status, data.flag)
    end
end

-- 联盟战对阵列表
function GuildNewwarController:handle14205( data )
    self:printMsgGuildNewwar(14205, data)
    if data and self.battle_list_window then
        self.battle_list_window:setData(data)
    end
end

-- 据点数据更新(本方与对方都走这里，变量更)
function GuildNewwarController:handle14206( data )
    self:printMsgGuildNewwar(14206, data)
    if data then
        if data.flag and data.flag == TRUE then
            self.model:updateMyGuildWarPositionData(data.defense)
        else
            self.model:updateEnemyGuildWarPositionData(data.defense)
        end
    end
end

-- 联盟战基础数据更新(星数、buff等)
function GuildNewwarController:handle14207( data )
    self:printMsgGuildNewwar(14207, data)
    if data then
        if data.result then
            self.model:setGuildWarResult(data.result)
        end
        if data.hp and data.buff_lev then
            local myBaseInfo = {}
            myBaseInfo.hp = data.hp
            myBaseInfo.buff_lev = data.buff_lev
            self.model:updateMyGuildWarBaseInfo(myBaseInfo)
        end
        if data.hp2 then
            self.model:updateEnemyGuildWarBaseInfo(data.hp2)
        end
        if data.ranks then
            self.model:setGuildWarTopThreeRank(data.ranks)
        end
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.UpdateGuildWarBaseInfoEvent)
    end
end

-- 本方据点数据
function GuildNewwarController:handle14208( data )
    self:printMsgGuildNewwar(14208, data)
    if data then
        self.model:setMyGuildWarPositionData(data.defense)
        self.model:setAvgPower(data.avg_power)
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.GetGuildWarMyPositionDataEvent)
    end
end

-- 防守记录
function GuildNewwarController:handle14209( data )
    self:printMsgGuildNewwar(14209, data)
    if data and self.defend_look_window then
        self.defend_look_window:setData(data)
    end
end

-- 有新的日志产生
function GuildNewwarController:handle14210(  )
    self:printMsgGuildNewwar(14210, data)
    self.model:updateGuildWarRedStatus(GuildConst.red_index.guildnewwar_log, true, true)
end

-- 战场日志
function GuildNewwarController:handle14212( data )
    self:printMsgGuildNewwar(14212, data)
    if self.battle_log_window and data then
        self.battle_log_window:setData(data.guild_league_peak_log)
    end
end

-- 联盟战详细排名
function GuildNewwarController:handle14213( data )
    if data then
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.UpdateGuildWarRankDataEvent, data.ranks)
