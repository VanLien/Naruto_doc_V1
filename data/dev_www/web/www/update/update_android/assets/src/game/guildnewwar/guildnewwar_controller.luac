-------------------------@ 界面
function GuildNewwarController:openGuildnewwarGateWindow( status, setting )
    if status == false then
        if self.guildnewwar_gate_window then
            self.guildnewwar_gate_window:close()
            self.guildnewwar_gate_window = nil
        end
    else
        if self.guildnewwar_gate_window == nil then
            self.guildnewwar_gate_window = GuildnewwarGateWindow.New()
        end
        if self.guildnewwar_gate_window:isOpen() == false then
            self.guildnewwar_gate_window:open(setting)
        end
    end
end

-- 打开联盟战主界面
function GuildNewwarController:openMainWindow( status )
	if status == false then
        if self.main_window then
            self.main_window:close()
            self.main_window = nil
        end
    else
        if(FILTER_CHARGE == true) then
            message(TI18N("语言_c_2050"))
            return;
        end

        if self.role_vo == nil or self.role_vo.gid == 0 then 
            message(TI18N("语言_c_538"))
            return 
        end
        local config = Config.GuildWarNewData.data_const.limit_lev
        if config == nil then 
            message(TI18N("语言_c_3858"))
            return
        end
        if self.role_vo.guild_lev < config.val then
            message(TI18N("语言_c_3859"))
            return 
        end
        if self.main_window == nil then
            self.main_window = GuildNewwarMainWindow.New()
        end
        if self.main_window:isOpen() == false then
            self.main_window:open()
        end
    end
end

