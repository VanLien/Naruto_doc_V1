-- 判断是否开启联盟战
function GuildNewwarController:checkIsCanOpenGuildWarWindow(not_tips)
    local isOpen = true
    local limit_lev = Config.GuildWarNewData.data_const.limit_lev.val
    local config_day = Config.GuildWarNewData.data_const.limit_open_time -- 开服天数限制
    local role_vo = RoleController:getInstance():getRoleVo()
    local open_srv_day = RoleController:getInstance():getModel():getOpenSrvDay()
    if not role_vo:isHasGuild() then
        if not not_tips then
            message(TI18N("语言_c_538"))
        end
        isOpen = false
    elseif role_vo.guild_lev < limit_lev then
        if not not_tips then
            message(TI18N("语言_c_3859"))
        end
        isOpen = false
    elseif open_srv_day <= config_day.val then
        if not not_tips then
            message(config_day.desc)
        end
        isOpen = false
    end
    return isOpen , limit_lev
end

-- 打开公会战宝箱奖励
function GuildNewwarController:openAwardBoxWindow( status )
    if status == true then
        if not self.award_box_win then
            self.award_box_win = GuildNewwarAwardBoxWindow.New()
        end
        if self.award_box_win:isOpen() == false then
            self.award_box_win:open()
        end
    else
        if self.award_box_win then
            self.award_box_win:close()
            self.award_box_win = nil
        end
    end
end

-- 打开宝箱奖励预览
function GuildNewwarController:openAwardBoxPreview( status )
    if status == true then
        if not self.award_box_preview then
            self.award_box_preview = GuildNewwarAwardBoxPreview.New()
        end
        if self.award_box_preview:isOpen() == false then
            self.award_box_preview:open()
        end
    else
        if self.award_box_preview then
            self.award_box_preview:close()
            self.award_box_preview = nil
        end
    end
end

