-- ui
--幸运转盘
function GuildNewwarController:openGuildnewwarTurntablePanel( status )
    if status == true then
        if not self.turntable_panel then
            self.turntable_panel = GuildnewwarTurntablePanel.New()
        end
        if self.turntable_panel:isOpen() == false then
            self.turntable_panel:open()
        end
    else
        if self.turntable_panel then
            self.turntable_panel:close()
            self.turntable_panel = nil
        end
    end
end
