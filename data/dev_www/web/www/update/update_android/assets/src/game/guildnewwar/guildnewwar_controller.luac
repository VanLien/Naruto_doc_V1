function GuildNewwarController:handle14244( data )
    self:printMsgGuildNewwar(14244, data)
    message(data.msg)
    if data.code == TRUE then
        --下次成功需要更新代币
        self:sender14241()
        self.model:setBetTypeInfo(data.bet_type)
        PromptController:getInstance():getModel():removePromptDataByTpye(PromptTypeConst.Guild_New_war)
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_GUESSING_STAKE_EVENT, data)
        if self.elite_guessing_count then
            self.elite_guessing_count:onClickCloseBtn()
        end
    end
end
