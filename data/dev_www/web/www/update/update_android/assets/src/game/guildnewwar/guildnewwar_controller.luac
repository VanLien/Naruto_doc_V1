    self:RegisterProtocal(14205, "handle14205")     -- 对战列表
    self:RegisterProtocal(14206, "handle14206")     -- 据点数据更新(只更新有变化的)
    self:RegisterProtocal(14207, "handle14207")     -- 联盟战基础数据更新（星数、buff等）
    self:RegisterProtocal(14208, "handle14208")     -- 本方联盟战据点数据
    self:RegisterProtocal(14209, "handle14209")     -- 防守记录
    self:RegisterProtocal(14210, "handle14210")     -- 有新的日志产生
    self:RegisterProtocal(14212, "handle14212")     -- 战场日志
