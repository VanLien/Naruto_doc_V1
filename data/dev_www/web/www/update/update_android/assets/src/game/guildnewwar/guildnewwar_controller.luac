----公会联赛状态(传奇赛)
function GuildNewwarController:sender14240()
    local protocal = {}
    self:SendProtocal(14240, protocal)
end

function GuildNewwarController:handle14240( data )
    self:printMsgGuildNewwar(14240, data)
    -- data.step = 1
    -- data.step_status = 5
    self.model:setMainData(data)
    GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_MAIN_EVENT, data)
    if data.step_status ~= GuildNewwarConst.guessing_set_status_type.set_status_quiz then
        PromptController:getInstance():getModel():removePromptDataByTpye(PromptTypeConst.Guild_New_war)
    end

    local is_open = self.model:checkGuildNewWarIsOpen(true)
    if not is_open then return end
    
    if data.step_status == GuildNewwarConst.guessing_set_status_type.set_status_quiz or data.step_status == GuildNewwarConst.guessing_set_status_type.set_status_Idle then
        --进竞猜阶段..后端才会刷新数据.这个时候我刷新一下数据 额外到休整期也会清
        self.model:setMatchData64(nil, data.zone_id)
        self.model:setMatchData8(nil, data.zone_id)
    end
    -- self.current_round_status = data.round_status

    --通知客户端观看录像
    if data.flag == GuildNewwarConst.guessing_flag_type.demand_radio then
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_SHOW_VEDIO_EVENT, data)
    end
end
