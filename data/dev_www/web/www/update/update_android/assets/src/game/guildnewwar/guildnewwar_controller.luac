    self:RegisterProtocal(14243, "handle14243")     -- 竞猜信息
    self:RegisterProtocal(14244, "handle14244")     -- 竞猜押注
    self:RegisterProtocal(14245, "handle14245")     -- 我的竞猜信息
    self:RegisterProtocal(14246, "handle14246")     -- 上次比赛结果信息
    self:RegisterProtocal(14247, "handle14247")     -- 竞猜押注实时更新
    self:RegisterProtocal(14248, "handle14248")     -- 我的PK信息
    self:RegisterProtocal(14249, "handle14249")     -- 获取64强信息
    self:RegisterProtocal(14250, "handle14250")     -- 获取8强信息
    self:RegisterProtocal(14251, "handle14251")     -- 请求对战詳情
    self:RegisterProtocal(14252, "handle14252")     -- 请求对战列表
