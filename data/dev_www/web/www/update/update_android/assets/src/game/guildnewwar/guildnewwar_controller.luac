    self:SendProtocal(14201, protocal)
end

-- 发起战斗
function GuildNewwarController:requestGuildWarFighting( pos, hp, flag )
    if not pos then return end
    local protocal = {}
    protocal.pos = pos
    protocal.hp = hp
    protocal.flag = flag
    self:SendProtocal(14202, protocal)
end

