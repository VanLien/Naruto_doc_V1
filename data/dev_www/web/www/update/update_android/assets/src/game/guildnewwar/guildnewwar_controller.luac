----设置阵法
function GuildNewwarController:sender14232(formations,isTips)
    self.isTips = isTips or 0
    local protocal = {}
    protocal.formations = formations or {}
    self.record_formations = formations
    self:SendProtocal(14232, protocal)
end

function GuildNewwarController:handle14232( data )
    self:printMsgGuildNewwar(14232, data)
    if self.isTips == 0 then
        message(data.msg)
    end
    if data.code == TRUE then
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_SAVE_FROM_EVENT, data)
        if self.record_formations then
            local model = HeroController:getInstance():getModel()
            for i,v in ipairs(self.record_formations) do
                v.type = PartnerConst.Fun_Form.GuildNewWarLegend
                model:setFormList(v, v.order)
            end
        end
        HeroController:getInstance():getModel():NextBattle(14232)
    else
        GlobalEvent:getInstance():Fire(HeroEvent.Hero_no_Sacrifice_bttom_Event,data.msg,PartnerConst.Fun_Form.GuildNewWarLegend)
        HeroController:getInstance():getModel():NextBattle(14232)
    end
end
