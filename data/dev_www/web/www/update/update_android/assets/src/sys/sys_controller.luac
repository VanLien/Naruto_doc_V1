function SysController.registerEvents(arg_2_0)
	if arg_2_0.init_role_event == nil then
		arg_2_0.init_role_event = GlobalEvent:getInstance():Bind(EventId.ROLE_CREATE_SUCCESS, function()
			GlobalEvent:getInstance():UnBind(arg_2_0.init_role_event)

			arg_2_0.init_role_event = nil
			arg_2_0.role_vo = RoleController:getInstance():getRoleVo()

			if arg_2_0.role_vo and arg_2_0.role_assets_event == nil then
				arg_2_0.role_assets_event = arg_2_0.role_vo:Bind(RoleEvent.UPDATE_ROLE_ATTRIBUTE, function(arg_4_0, arg_4_1)
