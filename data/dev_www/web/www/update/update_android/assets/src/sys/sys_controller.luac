				end)
			end
		end)
	end

	if arg_2_0.world_lev_event == nil then
		arg_2_0.world_lev_event = GlobalEvent:getInstance():Bind(RoleEvent.WORLD_LEV, function()
			arg_2_0:crossarenaProtocal()
		end)
	end

	if arg_2_0.re_link_game_event == nil then
		arg_2_0.re_link_game_event = GlobalEvent:getInstance():Bind(LoginEvent.RE_LINK_GAME, function()
			if not RoleController:getInstance():checkRoleSetNameViewIsOpen() and not GuideController:getInstance():isInGuide() then
