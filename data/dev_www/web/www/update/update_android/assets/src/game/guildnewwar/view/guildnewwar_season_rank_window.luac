-- 切换标签页
function GuildnewwarSeasonRankWindow:changeSelectedTab( index )
    if self.tab_object and self.tab_object.index == index then return end

    if self.tab_object then
        self.tab_object.select_bg:setVisible(false)
        self.tab_object.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
        self.tab_object = nil
    end
    self.cur_tab_index = index
    self.tab_object = self.tab_list[index]

    -- self.label_tips:setVisible(index == GuildNewwarConst.RankType.legend)

    if self.tab_object then
        self.tab_object.select_bg:setVisible(true)
        self.tab_object.title:setTextColor(cc.c4b(0xff, 0xed, 0xd6, 0xff))
    end
    self:updateRankList(index)
end
--刷新列表
function GuildnewwarSeasonRankWindow:updateRankList(index)
    if not index then return end
    if self.rank_scrollview == nil then
        local scroll_view_size = self.rank_list:getContentSize()
        local setting = {
            item_class = GuildnewwarSeasonRankItem,      -- 单元类
            start_x = 0,                  -- 第一个单元的X起点
            space_x = 0,                    -- x方向的间隔
            start_y = 0,                    -- 第一个单元的Y起点
            space_y = 0,                   -- y方向的间隔
            item_width = 628,               -- 单元的尺寸width
            item_height = 125,              -- 单元的尺寸height
            row = 1,                        -- 行数，作用于水平滚动类型
            col = 1,                         -- 列数，作用于垂直滚动类型
            need_dynamic = true
        }
        self.rank_scrollview = CommonScrollViewLayout.new(self.rank_list, cc.p(0,0) , ScrollViewDir.vertical, ScrollViewStartPos.top, scroll_view_size, setting)
        self.rank_scrollview:setBounceEnabled(false)
    end
    self.rank_scrollview:setData(self.show_list[index] or {})
end

--setting.tab_type = GuildNewwarConst.RankType.division
function GuildnewwarSeasonRankWindow:openRootWnd(setting)
    if not self.tab_item_type then return end
    local setting = setting or {}
    local index = setting.index or GuildNewwarConst.RankType.division
    self:changeSelectedTab(index)

    self.zone_id = setting.zone_id
    select_zone_id = setting.zone_id
    GuildNewwarController:getInstance():sender14224(self.zone_id)
    -- self:updateMyRank()
end

function GuildnewwarSeasonRankWindow:updateMyRank()
    local season_data = GuildNewwarController:getInstance():getModel():getSeasonData()
    if not season_data then return end
    local guild_info = GuildController:getInstance():getModel():getMyGuildInfo()
    if not guild_info then return end
    local ranks = self.show_list[GuildNewwarConst.RankType.division]
    local rank_num = 0
    for i, v in ipairs(ranks) do
        if v.gid == guild_info.gid and v.srv_id == guild_info.gsrv_id then
            rank_num = v.rank
            break
        end
    end

    self.no_rank_label:setVisible(false)
    self.my_name_label:setString(guild_info.name)
    self.my_svr:setString(string_format(TI18N("语言_c_558"), season_data.zone_id))
    self.label_power:setString(guild_info.power or 0)
    self.label_cups:setString(season_data.cups)
    local badge_data = GuildController:getInstance():getModel():getBadgeItemData()
    self.badge_item:setData(badge_data)

    local index = rank_num
	self.rank_id:setString(index)
	if index >= 1 and index <= 3 then
        self.rank_id:setVisible(false)
        self.rank_img:setVisible(true)
		self.rank_img:loadTexture(PathTool.getResFrame("common","common_200"..index),LOADTEXT_TYPE_PLIST)
        self.rank_img:setScale(0.7)
    elseif index == 0 then
        self.rank_id:setVisible(true)
        self.rank_img:setVisible(false)
        self.rank_id:setString(TI18N("语言_c_4935"))
    else
        self.rank_id:setVisible(true)
        self.rank_img:setVisible(false)
    end

    local config = Config.GuildWarNewData.data_guild_war_level[season_data.dan]
    self.level_name2:setString(config.name)
    local name = config.little_ico
    if name == nil or name == "" then
        name = "icon_iron"
    end
    local bg_res = PathTool.getPlistImgForDownLoad("elitematch/elitematch_icon",name, false)
    self.item_load = loadSpriteTextureFromCDN(self.icon , bg_res, ResourcesType.single, self.item_load)
end

function GuildnewwarSeasonRankWindow:close_callback()
    doStopAllActions(self.time_lab)
    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    controller:openGuildnewwarSeasonRankWindow(false)
end

------------------------------@ item
GuildnewwarSeasonRankItem = class("GuildnewwarSeasonRankItem",function()
    return ccui.Layout:create()
end)

function GuildnewwarSeasonRankItem:ctor()
    local csbPath = PathTool.getTargetCSB("guildnewwar/guildnewwar_season_rank_item")
    self.root_wnd = cc.CSLoader:createNode(csbPath)
    self.size = cc.size(628, 125)
    self:setAnchorPoint(cc.p(0.5, 0.5))
    self:setContentSize(self.size)
    self:setTouchEnabled(true)
    self.root_wnd:setAnchorPoint(0.5, 0.5)
    self.root_wnd:setPosition(self.size.width * 0.5, self.size.height * 0.5)
    self:addChild(self.root_wnd)

    local container = self.root_wnd:getChildByName("container")
    self.rank_img = container:getChildByName("rank_img")
    self.rank_img:ignoreContentAdaptWithSize(true)
    self.rank_index = container:getChildByName("rank_index")
    self.g_name = container:getChildByName("g_name")
    self.g_srv = container:getChildByName("g_srv")
    local node_rank = container:getChildByName("node_rank")
    local badge_item = GuildBadgeItem.new()
    self.badge_item = badge_item
    node_rank:addChild(badge_item)
    
    self.g_power = container:getChildByName("g_power")
    self.icon = container:getChildByName('icon')
    self.level_name2 = container:getChildByName('level_name2')
    self.label_cups = container:getChildByName('label_cups')
    self.container = container

    self:registerEvent()
end

function GuildnewwarSeasonRankItem:registerEvent()
    --这里弹公会信息面板
	self:addTouchEventListener(function(sender, event_type)
		customClickAction_2(sender,event_type)
		if event_type == ccui.TouchEventType.ended then
            self.touch_end = sender:getTouchEndPosition()
            local is_click = true
            if self.touch_began ~= nil then
                is_click =
                    math.abs(self.touch_end.x - self.touch_began.x) <= 10 and
                    math.abs(self.touch_end.y - self.touch_began.y) <= 10
            end
            if is_click == true then
                playButtonSound2()
                GuildController:getInstance():send13509(self.data.gid, self.data.srv_id)
            end
        elseif event_type == ccui.TouchEventType.began then
            self.touch_began = sender:getTouchBeganPosition()
		end
    end)
end

function GuildnewwarSeasonRankItem:addCallBack(call_back)
    self.call_back = call_back
end

function GuildnewwarSeasonRankItem:setData(data, index)
    self.data = data
    -- self.badge_item:setData(data)
    self.g_name:setString(data.name or "--")
    -- self.g_srv:setString(string_format(TI18N("语言_c_558"), select_zone_id))
    local srv_name = getServerName(data.srv_id)
    if srv_name == "" then
        srv_name = TI18N("语言_c_101")
    end
    self.g_srv:setString(string_format("[%s]",srv_name))
    self.g_power:setString(data.power or "--")
    self.label_cups:setString(data.cups or "--")
    local badge_data = GuildController:getInstance():getModel():getBadgeItemData(data.avatar, data.avatar_frame)
    self.badge_item:setData(badge_data)
    local index = data.rank
	self.rank_index:setString(index)
	if index >= 1 and index <= 3 then
        self.rank_index:setVisible(false)
        self.rank_img:setVisible(true)
		self.rank_img:loadTexture(PathTool.getResFrame("common","common_200"..index),LOADTEXT_TYPE_PLIST)
		self.rank_img:setScale(0.7)
    else
        self.rank_index:setVisible(true)
        self.rank_img:setVisible(false)
    end

    local config = Config.GuildWarNewData.data_guild_war_level[data.dan]
    self.level_name2:setString(config.name)
    local name = config.little_ico
    if name == nil or name == "" then
        name = "icon_iron"
    end
    local bg_res = PathTool.getPlistImgForDownLoad("elitematch/elitematch_icon",name, false)
    self.item_load = loadSpriteTextureFromCDN(self.icon , bg_res, ResourcesType.single, self.item_load)
end

function GuildnewwarSeasonRankItem:DeleteMe()
    if self.item_load then 
        self.item_load:DeleteMe()
        self.item_load = nil
    end
    self:removeAllChildren()
    self:removeFromParent()
end