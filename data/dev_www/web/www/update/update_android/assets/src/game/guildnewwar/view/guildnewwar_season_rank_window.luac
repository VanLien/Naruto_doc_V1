GuildnewwarSeasonRankWindow = GuildnewwarSeasonRankWindow or BaseClass(BaseView)

local controller = GuildNewwarController:getInstance()
local model = controller:getModel()
local string_format = string.format

local select_zone_id = 0

function GuildnewwarSeasonRankWindow:__init()
    self.win_type = WinType.Big
    self.view_tag = ViewMgrTag.DIALOGUE_TAG
    self.res_list = {
        
    }
    self.layout_name = "guildnewwar/guildnewwar_season_rank_window"

    self.show_list = {}
end

function GuildnewwarSeasonRankWindow:open_callback(  )
    self.background = self.root_wnd:getChildByName("background")
    if self.background ~= nil then
        self.background:setScale(display.getMaxScale())
    end
    self.main_container = self.root_wnd:getChildByName("main_container")
    -- 通用进场动效
    ActionHelp.itemUpAction(self.main_container, 720, 0, 0.25)
    
    local main_panel = self.main_container:getChildByName("main_panel")
    self.rank_list = main_panel:getChildByName("rank_list")
    self.title = main_panel:getChildByName("win_title")
    self.title:setString(TI18N("语言_c_5247"))
    local Image_2 = main_panel:getChildByName("Image_2")
    moveTextBg(self.title,Image_2,60,Image_2:getContentSize().width)
    self.close_btn = main_panel:getChildByName("close_btn")
    self.label_tips = main_panel:getChildByName("label_tips")
    self.label_tips:setString(TI18N("语言_c_6293"))
    self.label_tips:setTextHorizontalAlignment(cc.TEXT_ALIGNMENT_CENTER)
    self.label_tips:setAnchorPoint(cc.p(0.5, 0.5))
    self.label_tips:setPositionX(339)
    -- self.label_tips:setVisible(false)
    main_panel:getChildByName("rank_title_1"):setString(TI18N("语言_s_12"))
    main_panel:getChildByName("rank_title_2"):setString(TI18N("语言_c_5101"))
    main_panel:getChildByName("rank_title_3"):setString(TI18N("语言_c_5104"))
    main_panel:getChildByName("rank_title_4"):setString(TI18N("语言_c_452"))

    self.my_rank = main_panel:getChildByName("my_rank")
    local title = self.my_rank:getChildByName('title')
    title:setString(TI18N("语言_c_258"))
    self.no_rank_label = self.my_rank:getChildByName("no_rank_label")
    self.no_rank_label:setVisible(false)
    self.no_rank_label:setString(TI18N("语言_c_285"))
    self.rank_id = self.my_rank:getChildByName("rank_id")
    self.rank_img = self.my_rank:getChildByName("rank_img")
    self.rank_img:ignoreContentAdaptWithSize(true)
    self.my_name_label = self.my_rank:getChildByName("my_name_label")
    self.my_svr = self.my_rank:getChildByName("my_svr")
    self.label_power = self.my_rank:getChildByName("label_power")
    self.label_cups = self.my_rank:getChildByName("label_cups")
    local node_rank = self.my_rank:getChildByName('node_rank')
	local badge_item = GuildBadgeItem.new()
    self.badge_item = badge_item
    node_rank:addChild(badge_item)
    self.icon = self.my_rank:getChildByName('icon')
    self.level_name2 = self.my_rank:getChildByName('level_name2')

    self.tab_container = self.main_container:getChildByName("tab_container")
    local tab_name_list = {
        [1] = TI18N("语言_c_5247"),
        [2] = TI18N("语言_c_3861"),
    }
    self.tab_item_type = {
        [1] = GuildNewwarConst.RankType.division,
        [2] = GuildNewwarConst.RankType.legend,
    }
    self.tab_list = {}
    for i=1,2 do
        local tab_btn = self.tab_container:getChildByName("tab_btn_"..i)
        if tab_btn then
            local object = {}
            object.select_bg = tab_btn:getChildByName('select_bg')
            object.select_bg:setVisible(false)
            object.unselect_bg = tab_btn:getChildByName('unselect_bg')
            object.title = tab_btn:getChildByName("title")
            object.title:setTextColor(cc.c4b(0xcf, 0xb5, 0x93, 0xff))
            if tab_name_list[i] then
                object.title:setString(tab_name_list[i])
            end
            object.tab_btn = tab_btn
            object.index = self.tab_item_type[i] or GuildNewwarConst.RankType.division
            self.tab_list[i] = object
        end
    end
end

function GuildnewwarSeasonRankWindow:register_event(  )
    registerButtonEventListener(self.background, function() self:onClosedBtn() end,false, 2)
    registerButtonEventListener(self.close_btn, function() self:onClosedBtn() end ,true, 2)
    for k, object in pairs(self.tab_list) do
        if object.tab_btn then
            object.tab_btn:addTouchEventListener(function(sender, event_type)
                if event_type == ccui.TouchEventType.ended then
                    playTabButtonSound()
                    self:changeSelectedTab(object.index)
                end
            end)
        end
    end

    --赛季排行
    self:addGlobalEvent(GuildNewwarEvent.GUILDNEWWAR_NOMAL_RANK, function(data)
        if not data then return end
        self.show_list[GuildNewwarConst.RankType.division] = data
        self:updateMyRank()
        self:updateRankList(GuildNewwarConst.RankType.division)
    end)
end

--关闭
function GuildnewwarSeasonRankWindow:onClosedBtn()
    controller:openGuildnewwarSeasonRankWindow(false)
end

