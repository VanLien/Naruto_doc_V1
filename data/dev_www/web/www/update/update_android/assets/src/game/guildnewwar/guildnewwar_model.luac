function GuildNewwarModel:checkPeakChampionTotalRedPoint(need_check)
    local is_open = self:checkGuildNewWarIsOpen(true)
    if not is_open then return false end

    local redpoint = self:getGuessRedPoint()
    -- if redpoint then
    --     PromptController:getInstance():getModel():addPromptData({type = PromptTypeConst.Guild_New_war})
    -- else
    --     PromptController:getInstance():getModel():removePromptDataByTpye(PromptTypeConst.Guild_New_war)
    -- end

    if self.main_data then
        if not redpoint then
            if self.my_match_redpoint or self.match_stage_redpoint then
                redpoint = true
            end
        end

        -- --点赞红点
        -- if not redpoint  then
        --     redpoint = self.is_worship_redpoint or false
        -- end
    end

    if need_check then
        GlobalEvent:getInstance():Fire(GuildNewwarEvent.GUILDNEWWAR_ALL_RED_POINT_EVENT)
    end
	-- 抽奖
	redpoint = redpoint or self:checkLegendTurnTable()
    return redpoint
end

function GuildNewwarModel:checkLegendTurnTable()
	local is_open = self:checkGuildNewWarIsOpen(true)
    if not is_open then return false end
	local item_bid = Config.DialData.data_const["elite_consume_item"].val
	local num = BackpackController:getInstance():getModel():getBackPackItemNumByBid(item_bid)
	return num > 0
end

