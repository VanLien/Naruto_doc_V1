--获取是否竞猜的红点
function GuildNewwarModel:getGuessRedPoint()
    if self.main_data and self.my_bet_info then
        if self.main_data.step ~= 0 and self.main_data.step_status == 4 then
			--竞猜阶段 我未下注
			if self.my_bet_info.bet_type == 0 then 
				return true
			end
        end
    end
    return false
end

function GuildNewwarModel:setLoginRedPoint(data)
    if not data then  return end
    if not self.main_data then return end
    for i,v in ipairs(data.point_info) do
        if v.type == 1 then --我的赛程
            self.my_match_redpoint = (v.is_point == 0)
        elseif v.type == 2 then --晋级赛红点/64强红点
            if self.main_data.step == 64  or self.main_data.step == 8 then
                self.match_stage_redpoint = (v.is_point == 0)
            else
                self.match_stage_redpoint = false
            end
        end
    end
    self:checkPeakChampionTotalRedPoint(true)
end

function GuildNewwarModel:getMyMatchRedPoint()
	return self.my_match_redpoint
end

function GuildNewwarModel:setMyMatchRedPoint(status)
    self.my_match_redpoint = status
    self:checkPeakChampionTotalRedPoint(true)
end

function GuildNewwarModel:getMatchStageRedPoint()
	local redpoint = self.match_stage_redpoint or self:getGuessRedPoint()
	return redpoint
end

function GuildNewwarModel:setMatchStageRedPoint(status)
    self.match_stage_redpoint = status
    self:checkPeakChampionTotalRedPoint(true)
end

--我的下注信息
function GuildNewwarModel:setBetTypeInfo(bet_type)
    self.my_bet_type = bet_type
    if self.main_data and self.my_bet_type then
        self:checkPeakChampionTotalRedPoint(true)
    end
end

function GuildNewwarModel:setBetInfo(bet_info)
	self.my_bet_info = bet_info
end

function GuildNewwarModel:getBetInfo()
	return self.my_bet_info
end

function GuildNewwarModel:updateBetInfo(data)
	if not self.my_bet_info then
		self.my_bet_info = {}
	end
    self.my_bet_info.a_bet = data.a_bet
    self.my_bet_info.a_bet_ratio = data.a_bet_ratio
    self.my_bet_info.b_bet = data.b_bet
    self.my_bet_info.b_bet_ratio = data.b_bet_ratio
end

function GuildNewwarModel:setMyGuessData(data)
    self.my_guess_data = data
end

function GuildNewwarModel:getMyGuessData()
    return self.my_guess_data
end


--64强数据
function GuildNewwarModel:setMatchData64(list, zone_id)
	if list then
		zone_id = zone_id or 1
	   self.match_data_64[zone_id] = {}
	   self.max_group_64[zone_id] = 0
	   for i,v in ipairs(list) do
		   self.match_data_64[zone_id][v.group] = v.pos_list
		   if self.max_group_64[zone_id] < v.group then
			   self.max_group_64[zone_id] = v.group
		   end
	   end
   else
	   self.match_data_64[zone_id] = nil  
	   self.max_group_64[zone_id] = 8  
   end
end
--根据组获取信息
function GuildNewwarModel:getMatchData64ByGroup(group, zone_id)
	zone_id = zone_id or 1
   if self.match_data_64 and self.match_data_64[zone_id] then
	   return self.match_data_64[zone_id][group]
   end
   return nil
end

--8强数据
function GuildNewwarModel:setMatchData8(data, zone_id)
	zone_id = zone_id or 1
   self.match_data_8[zone_id] = data
end

function GuildNewwarModel:getMatchData8(zone_id)
	zone_id = zone_id or 1
   return self.match_data_8[zone_id]
end

--获取比赛的阶段描述
--return 比赛标题 , 比赛阶段
function GuildNewwarModel:getMacthText(step, step_status)
    if not step then return end
    if step == 0 then
        if self:isBeforeOpenMacthTime() then
            return TI18N("语言_c_561")
        else
            return TI18N("语言_c_562")
        end
    else
        local str = nil
        local str1 = nil
        local step_str = {TI18N("语言_c_5380"),TI18N("语言_c_5381"),TI18N("语言_c_5384"),TI18N("语言_c_5385"),TI18N("语言_c_5386"),TI18N("语言_c_5387")}
        str = step_str[step]

        if step_status then
            if step_status == 4 then
                str1 = TI18N("语言_c_4280")
            elseif step_status == 5 then
                str1 = TI18N("语言_c_4281")
            elseif step_status == 3 then
                str1 = TI18N("语言_c_120")
            elseif step_status == 2 then 
                str1 = TI18N("语言_c_5378")
			elseif step_status == 6 then 
                str1 = TI18N("语言_c_4983")
            else --默认休整阶段
                str1 = TI18N("语言_c_5379")
            end
        end
        return str, str1
    end
end

function GuildNewwarModel:isBeforeOpenMacthTime()
    if not self.main_data then return false end

    if self.main_data.step == 0 or self.main_data.step_status == 2 then

        local time = self.main_data.start_time - GameNet:getInstance():getTime()
        if time < 0 then
            time = 0
        end
        --策划说 离开启时间 5天 6个小时跨服竞技场赛就是巅峰冠军赛季
        local total_time =  5*24*60*60 + 6*60*60
        if time <= total_time then
            return true
        else
            return false
        end
    else
        return false
    end

end

--保存整容判断是否在竞猜或者战斗阶段
function GuildNewwarModel:checkIsSaveFormStatus()
	if not self.main_data then return false, TI18N("语言_c_5382") end
    if self.main_data.step_status == GuildNewwarConst.guessing_set_status_type.set_status_quiz then
		return false, TI18N("语言_c_5353")
	end
	if self.main_data.step_status == GuildNewwarConst.guessing_set_status_type.set_status_battle then
		return false, TI18N("语言_c_5353")
	end
	if self.main_data.step_status == GuildNewwarConst.guessing_set_status_type.set_status_broadcast then
		return false, TI18N("语言_c_5353")
	end
	return true
end

function GuildNewwarModel:__delete()
end