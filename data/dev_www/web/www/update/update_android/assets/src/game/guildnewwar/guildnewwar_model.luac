--是否赛季开启
function GuildNewwarModel:checkSeasonIsStart()
	if self.main_data then
		local now_time = GameNet:getInstance():getTime() 
		return now_time > self.main_data.start_time and now_time < self.main_data.end_time
	end
	return false
end

